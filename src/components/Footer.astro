---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-[#050505] transition-colors pb-4 px-4 md:px-6">
  <!-- Rounded Card Container -->
  <div class="bg-[#0a0a0a] rounded-[2.5rem] md:rounded-[3rem] text-white pt-16 md:pt-24 pb-8 px-8 md:px-12 w-full max-w-[1600px] mx-auto flex flex-col">
    
    <!-- Top Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 mb-24">
      
      <!-- Column 1: EMAIL & SOCIAL -->
      <div class="lg:col-span-6 flex flex-col gap-16">
        <div>
          <h4 class="text-xs font-mono tracking-[0.2em] uppercase text-gray-500 mb-6">Email</h4>
          <a href="mailto:support@nismara.web.id" class="text-2xl md:text-4xl font-medium tracking-tight hover:text-primary-400 transition-colors">
            support@nismara.web.id
          </a>
        </div>
        <div>
          <div class="flex gap-4">
            <!-- Icons -->
            <a href="https://link.nismara.web.id/youtube" target="_blank" aria-label="YouTube" class="w-10 h-10 rounded-full border border-gray-800 flex items-center justify-center text-gray-400 hover:bg-white hover:text-black transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
            <a href="https://link.nismara.web.id/instagram" target="_blank" aria-label="Instagram" class="w-10 h-10 rounded-full border border-gray-800 flex items-center justify-center text-gray-400 hover:bg-white hover:text-black transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a href="https://link.nismara.web.id/discord" target="_blank" aria-label="Discord" class="w-10 h-10 rounded-full border border-gray-800 flex items-center justify-center text-gray-400 hover:bg-[#5865F2] hover:text-white hover:border-[#5865F2] transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      
      <!-- Column 2: STUDIO -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-mono tracking-[0.2em] uppercase text-gray-500 mb-6">Division</h4>
        <ul class="space-y-4 text-base text-gray-300 font-light">
          <li><a href="https://transport.nismara.web.id/" class="hover:text-white transition-colors block">Nismara Transport</a></li>
          <li><a href="https://racing.nismara.web.id/" class="hover:text-white transition-colors block">Nismara Racing</a></li>
          <li><a href="/airlines" class="hover:text-white transition-colors block">Nismara Airlines</a></li>
          <li><a href="/farm" class="hover:text-white transition-colors block">Nismara Farm</a></li>
          <li><a href="/rice-kencur" class="hover:text-white transition-colors block">RICE KENCUR</a></li>
          <li><a href="/blck" class="hover:text-white transition-colors block">BLCK</a></li>
        </ul>
      </div>

      <!-- Column 3: RESOURCES -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-mono tracking-[0.2em] uppercase text-gray-500 mb-6"> Navigation</h4>
        <ul class="space-y-4 text-base text-gray-300 font-light">
          <li><a href="/" class="hover:text-white transition-colors block">Home</a></li>
          <li><a href="/about-us" class="hover:text-white transition-colors block">About Us</a></li>
          <li><a href="/articles" class="hover:text-white transition-colors block">Articles</a></li>
          <li><a href="/faq" class="hover:text-white transition-colors block">FAQ</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors block">Contact</a></li>
          <li><a href="https://services.nismara.web.id/" class="hover:text-white transition-colors block">Status Services</a></li>
        </ul>
      </div>

    </div>
    
    <!-- Giant Logo -->
    <div class="w-full flex justify-between items-end mb-8 select-none">
      <h2 class="text-[16vw] md:text-[14vw] lg:text-[12vw] leading-[0.85] font-bold tracking-tighter text-white uppercase -ml-1 md:-ml-2 whitespace-nowrap flex items-start">
        NISMARA<span class="text-gray-600 font-medium ml-2 md:ml-4 text-[5vw] lg:text-[4vw] leading-none">&reg;</span>
      </h2>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800/60 pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-2">
      <div class="flex flex-wrap gap-6 md:gap-8 text-xs md:text-sm font-mono uppercase tracking-[0.15em] text-gray-400">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms</a>
        <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
      </div>
      <div class="text-xs md:text-sm font-mono tracking-[0.1em] text-gray-500">
        &copy; {currentYear} Nismara Group. All rights reserved.
      </div>
    </div>
    
  </div>
</footer>
