---
// AnimeFooter.astro
// Anime-style footer inspired by bright, vibrant idol/gaming websites.
---

<footer class="relative w-full bg-[#56365C] text-white font-sans">
  <!-- Wavy Top Divider -->
  <div class="absolute top-0 left-0 w-full leading-none z-10 transform -translate-y-[99%] pointer-events-none">
    <svg class="relative block w-full h-[100px] md:h-[150px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V120H0Z" fill="#56365C" opacity=".5"></path>
      <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V120H0Z" fill="#56365C"></path>
    </svg>
  </div>

  <div class="max-w-[1400px] mx-auto px-6 md:px-12 pt-16 pb-8 relative z-20 flex flex-col lg:flex-row justify-between items-end min-h-[500px]">
    
    <!-- Left Content: Info Card & Links -->
    <div class="w-full lg:w-[60%] flex flex-col z-30 mb-12 lg:mb-0">
      
      <!-- Logo / Title -->
      <div class="mb-8">
        <img src="/images/nismara-group-logo-white.png" alt="Nismara Group" class="h-16 md:h-24 w-auto mb-2 drop-shadow-md" />
        <p class="text-white/90 font-medium tracking-widest uppercase text-sm mt-2">Connecting The Virtual World</p>
      </div>

      <!-- Rounded Info Card -->
      <div class="bg-[#fcf5f7] text-gray-800 rounded-[2rem] p-6 md:p-8 w-full max-w-[600px] shadow-2xl relative mb-8">
        <!-- Small decorative element on card -->
        <div class="absolute -top-4 -right-4 w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-lg text-[#56365C]">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </div>

        <div class="flex flex-col md:flex-row gap-6 items-center md:items-start">
          <div class="w-24 h-24 flex-shrink-0 bg-white rounded-2xl overflow-hidden border-4 border-white shadow-md p-2">
            <img src="/images/nismara-group-logo.png" alt="App Icon" class="w-full h-full object-contain" />
          </div>
          
          <div class="flex-1 text-sm md:text-base font-bold text-gray-700 w-full space-y-2">
            <div class="flex"><span class="w-32 text-gray-400">Company</span> <span class="text-[#56365C]">Nismara Group</span></div>
            <div class="flex"><span class="w-32 text-gray-400">Sector</span> <span>Virtual Simulation</span></div>
            <div class="flex"><span class="w-32 text-gray-400">Since</span> <span>August 2025</span></div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3 justify-center md:justify-start">
          <a href="https://link.nismara.web.id/discord" target="_blank" class="bg-[#5865F2] text-white px-4 py-2 rounded-xl flex items-center gap-2 hover:scale-105 transition-transform shadow-md">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
            <span class="font-bold text-sm">Discord</span>
          </a>
          <a href="https://link.nismara.web.id/instagram" target="_blank" class="bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] text-white px-4 py-2 rounded-xl flex items-center gap-2 hover:scale-105 transition-transform shadow-md">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            <span class="font-bold text-sm">Instagram</span>
          </a>
          <a href="https://link.nismara.web.id/youtube" target="_blank" class="bg-[#FF0000] text-white px-4 py-2 rounded-xl flex items-center gap-2 hover:scale-105 transition-transform shadow-md">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span class="font-bold text-sm">YouTube</span>
          </a>
          <a href="https://career.nismara.web.id" target="_blank" class="bg-gray-900 text-white px-4 py-2 rounded-xl flex items-center gap-2 hover:scale-105 transition-transform shadow-md">
            <span class="font-bold text-sm">Career</span>
          </a>
        </div>
      </div>

      <!-- Fine Print -->
      <div class="text-[10px] md:text-xs text-white/80 font-medium leading-relaxed max-w-[600px] mb-8 space-y-1">
        <p>*Nismara Group is a virtual roleplay ecosystem, not a real-world registered corporation.</p>
        <p>*All divisions (Airlines, Transport, Racing) operate within simulation games like ETS2, ATS, and MSFS.</p>
        <p>*Artworks and assets are property of their respective creators or Nismara Group.</p>
        <p>&copy; {new Date().getFullYear()} Nismara Group. All rights reserved.</p>
      </div>

      <!-- Partner Logos -->
      <div class="flex flex-wrap gap-4 items-center mb-10">
        <a href="https://transport.nismara.web.id" target="_blank" class="bg-white px-4 py-2 rounded-md h-12 flex items-center justify-center font-black text-gray-800 text-sm italic shadow-sm hover:-translate-y-1 hover:text-[#56365C] transition-transform">
          TRANSPORT
        </a>
        <a href="/airlines" class="bg-white px-4 py-2 rounded-md h-12 flex items-center justify-center font-black text-gray-800 text-sm italic shadow-sm hover:-translate-y-1 hover:text-[#56365C] transition-transform">
          AIRLINES
        </a>
        <a href="https://racing.nismara.web.id" target="_blank" class="bg-white px-4 py-2 rounded-md h-12 flex items-center justify-center font-black text-gray-800 text-sm italic shadow-sm hover:-translate-y-1 hover:text-[#56365C] transition-transform">
          RACING
        </a>
        <a href="/farm" class="bg-white px-4 py-2 rounded-md h-12 flex items-center justify-center font-black text-gray-800 text-sm italic shadow-sm hover:-translate-y-1 hover:text-[#56365C] transition-transform">
          FARMS
        </a>
        <a href="/blck" class="bg-white px-4 py-2 rounded-md h-12 flex items-center justify-center font-black text-gray-800 text-sm italic shadow-sm hover:-translate-y-1 hover:text-[#56365C] transition-transform">
          BLCK
        </a>
        <a href="/rice-kencur" class="bg-white px-4 py-2 rounded-md h-12 flex items-center justify-center font-black text-gray-800 text-sm italic shadow-sm hover:-translate-y-1 hover:text-[#56365C] transition-transform">
          RICEKENCUR
        </a>
      </div>

      <!-- Footer Links -->
      <div class="flex flex-wrap gap-4 text-xs font-bold uppercase tracking-wider text-white">
        <a href="/terms" class="hover:underline">Terms of Service</a>
        <a href="/privacy" class="hover:underline">Privacy Policy</a>
        <a href="/about-us" class="hover:underline">About Us</a>
        <a href="/articles" class="hover:underline">Publications</a>
        <a href="/contact" class="hover:underline">Contact</a>
        <a href="/cookies" class="hover:underline">Cookie Policy</a>
        <a href="/faq" class="hover:underline">FAQ</a>
      </div>

    </div>

  </div>

  <!-- Right Character Artwork (Natasya) -->
  <div class="absolute bottom-0 right-0 md:right-[5%] lg:right-[10%] w-[350px] md:w-[500px] lg:w-[650px] h-full pointer-events-none z-10 flex items-end">
    <!-- Drop shadow for the character to pop -->
    <img 
      src="/images/natasya.webp" 
      alt="Natasya - Nismara Receptionist" 
      class="w-full h-auto object-contain object-bottom drop-shadow-[0_0_20px_rgba(0,0,0,0.3)] origin-bottom hover:scale-105 transition-transform duration-500 pointer-events-auto"
      style="max-height: 130%;"
      onerror="this.src='https://placehold.co/600x800/transparent/white?text=Natasya'"
    />
  </div>

  <!-- Vertical Name Tag on the Far Right -->
  <div class="hidden lg:block absolute right-6 top-1/2 -translate-y-1/2 bg-white text-[#56365C] font-black text-4xl tracking-widest py-8 px-2 rounded-l-2xl shadow-xl z-40 whitespace-pre" style="writing-mode: vertical-rl; text-orientation: mixed;">
     N A T A S Y A 
  </div>
  
</footer>
