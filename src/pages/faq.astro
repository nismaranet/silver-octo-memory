---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'Bagaimana cara bergabung dengan Nismara?',
    a: 'Sangat mudah! Anda hanya perlu mendaftarkan diri melalui halaman "Join Us" atau bergabung langsung ke server Discord kami. Sistem rekrutmen kami saat ini terpusat di Discord untuk memudahkan komunikasi antar-staf dan anggota baru.'
  },
  {
    q: 'Apakah harus punya full DLC map untuk bergabung di divisi Transport?',
    a: 'Tidak. Anda cukup memiliki game base/original Euro Truck Simulator 2 atau American Truck Simulator di akun Steam Anda. DLC bersifat opsional dan tidak diwajibkan untuk menjadi anggota Nismara Transport.'
  },
  {
    q: 'Apakah bergabung di Nismara Group dipungut biaya?',
    a: 'Sama sekali tidak. Seluruh layanan, keanggotaan, dan ekosistem Nismara Group bersifat 100% gratis. Kami adalah komunitas hobi yang mengedepankan persaudaraan dan profesionalisme dalam dunia simulasi virtual.'
  },
  {
    q: 'Apa itu Nismara Transport dan Nismara Racing?',
    a: 'Nismara Transport adalah divisi logistik dan transportasi penumpang (VTC) tempat para penggemar game truk/bus berkumpul dan berkonvoi bersama. Sementara itu, Nismara Racing adalah divisi e-motorsport kompetitif kami yang mewakili nama Nismara di berbagai turnamen balap virtual tingkat tinggi.'
  },
  {
    q: 'Game apa saja yang bernaung di bawah Nismara World?',
    a: 'Nismara World menaungi subdivisi game non-otomotif dan dunia terbuka, termasuk Rice Kencur untuk ekosistem komunitas Minecraft, BLCK untuk game aksi terpusat seperti GTA V, dan Nismara Farm untuk para penggemar Farming Simulator.'
  },
  {
    q: 'Saya mengalami masalah teknis saat mengakses layanan. Ke mana saya harus melapor?',
    a: 'Silakan bergabung dengan server Discord kami dan buat "Support Ticket" di kanal bantuan khusus yang telah disediakan. Tim staf dan dukungan teknis kami bersiaga 24/7 untuk membantu segala kendala teknis Anda.'
  }
];
---

<Layout title="FAQ - Nismara Group">
  <main class="bg-gray-50 dark:bg-black transition-colors min-h-screen pt-32 pb-32">
    <!-- Hero Section -->
    <section class="py-16 px-6 relative overflow-hidden">
      <div class="max-w-4xl mx-auto text-center reveal">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 rounded-2xl mb-8 transform -rotate-6 shadow-sm">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-gray-900 dark:text-white uppercase mb-6 leading-none">
          Common <span class="text-primary-600 dark:text-primary-500">Questions</span>
        </h1>
        <p class="text-xs font-bold tracking-[0.3em] text-gray-400 dark:text-gray-500 uppercase">
          Pusat Bantuan & Pertanyaan Umum Nismara
        </p>
      </div>
    </section>

    <!-- Discord CTA Banner -->
    <section class="px-6 mb-16 reveal delay-100">
      <div class="max-w-3xl mx-auto">
        <div class="p-8 rounded-3xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-center shadow-xl shadow-black/5 dark:shadow-none flex flex-col md:flex-row items-center justify-between gap-6">
          <p class="text-gray-600 dark:text-gray-400 font-medium text-left text-sm md:text-base leading-relaxed">
            Punya pertanyaan yang belum terjawab di sini? Langsung tanyakan di kanal Discord kami untuk respon lebih cepat dari staf operasional.
          </p>
          <a href="https://link.nismara.web.id/discord" target="_blank" class="shrink-0 inline-flex items-center gap-3 px-8 py-4 bg-indigo-500 hover:bg-indigo-600 text-white text-xs font-bold uppercase tracking-widest rounded-xl transition-all transform hover:-translate-y-1 shadow-lg shadow-indigo-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
            Tanya di Discord
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion List -->
    <section class="px-6 reveal delay-200">
      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((faq, i) => (
          <details class="group bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-3xl overflow-hidden shadow-sm transition-all hover:border-primary-300 dark:hover:border-primary-800 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer select-none outline-none">
              <div class="flex items-center gap-4 md:gap-6 pr-4">
                <div class="w-10 h-10 shrink-0 rounded-full bg-gray-50 dark:bg-black border border-gray-200 dark:border-gray-800 flex items-center justify-center text-gray-400 dark:text-gray-500 group-open:bg-primary-600 group-open:border-primary-600 group-open:text-white transition-colors duration-300">
                  <span class="font-bold text-sm">{i + 1}</span>
                </div>
                <h3 class="text-lg md:text-xl font-bold tracking-tight text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {faq.q}
                </h3>
              </div>
              <span class="shrink-0 transition-transform duration-500 group-open:rotate-180 text-gray-400 dark:text-gray-500 group-hover:text-primary-600 dark:group-hover:text-primary-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            
            <div class="px-6 md:px-8 pb-8 pt-0 pl-[5.5rem] md:pl-[6.5rem]">
              <div class="h-px w-full bg-gray-100 dark:bg-gray-800 mb-6"></div>
              <p class="text-gray-500 dark:text-gray-400 font-medium leading-relaxed">
                {faq.a}
              </p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
