---
import { getArticles, urlFor } from '../utils/sanity';
import Layout from '../layouts/Layout.astro';

const articles = await getArticles();
const recentArticles = articles.slice(0, 3);
---

<Layout animeFooter={true}>
  <!-- Hero Section (Asymmetric & Minimal) -->
  <section class="relative pt-32 pb-24 lg:pt-48 lg:pb-32 overflow-hidden bg-white dark:bg-slate-950 transition-colors duration-500">
    <!-- Subtle Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] dark:bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative flex flex-col lg:flex-row items-center justify-between">
      
      <!-- Left Content -->
      <div class="lg:w-2/3 reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 hairline-border rounded-full text-xs font-medium tracking-widest uppercase mb-8 text-gray-500 dark:text-gray-400">
          <span class="w-1.5 h-1.5 rounded-full bg-primary-600 animate-pulse"></span>
          Nismara Group
        </div>
        
        <h1 class="text-6xl sm:text-7xl lg:text-8xl font-black tracking-tighter text-gray-900 dark:text-white mb-8 leading-[0.9]">
          Simulate.<br />
          Connect.<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-gray-400 dark:from-primary-400 dark:to-gray-600">Evolve.</span>
        </h1>
        
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-lg mb-12 font-light leading-relaxed reveal delay-100">
          Nismara Group Menghidupkan dunia simulasi, membangun koneksi antar anggota komunitas, dan terus berkembang bersama.
        </p>
        
        <div class="flex items-center gap-6 reveal delay-200">
          <a href="#about" class="group relative px-8 py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium overflow-hidden transition-all hover:shadow-2xl">
            <span class="relative z-10 flex items-center gap-2">
              Discover
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </a>
          <a href="/about-us" class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium">
            About us
          </a>
        </div>
      </div>
      
      <!-- Right Ornamental Vertical Text -->
      <div class="hidden lg:flex lg:w-1/3 justify-end items-center reveal delay-300">
        <div class="flex items-center gap-6 opacity-20 dark:opacity-30">
          <p class="vertical-text text-5xl font-black tracking-widest text-gray-900 dark:text-white uppercase">
            Nismara
          </p>
          <div class="w-[1px] h-64 bg-gray-900 dark:bg-white"></div>
          <p class="vertical-text text-xl font-light tracking-[0.3em] text-gray-900 dark:text-white uppercase">
            Est. 2025
          </p>
        </div>
      </div>
      
    </div>
  </section>

  <!-- About Nismara Section -->
  <section id="about" class="relative py-24 bg-gray-50 dark:bg-[#0a0f1a] transition-colors duration-500 hairline-border border-l-0 border-r-0 overflow-hidden">
    <!-- Nismara Background Logo -->
    <img src="/nismara.svg" alt="" class="absolute top-0 right-0 w-[600px] h-auto opacity-10 dark:opacity-[0.02] invert dark:invert-0 pointer-events-none transform translate-x-1/4 -translate-y-1/4" aria-hidden="true" />
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 reveal">
        <div class="max-w-xl">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight">Apa itu Nismara?</h2>
        </div>
      </div>
      
      <!-- About Us Content -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 reveal delay-100">
        
        <!-- Left Column: Introduction & CTA -->
        <div class="lg:col-span-5 flex flex-col justify-between">
          <div>
            <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 font-light leading-relaxed mb-8">
              Nismara Group adalah sebuah sebuah grup perusahaan virtual yang dibentuk untuk menaungi banyak perusahaan virtual lain dibawahnya seperti Nismara Transport, Nismara Airlines, Nismara Racing untuk divisi balap dan lainnya. Kami membentuk ini dikarenakan kecintaan kami kepada permainan simulasi.
            </p>
            <p class="text-gray-500 dark:text-gray-400 font-light leading-relaxed mb-12">
              Lebih dari sekadar bermain, kami membangun ekosistem di mana kreativitas, kolaborasi, dan teknologi menyatu menjadi sebuah harmoni.
            </p>
          </div>
          
          <a href="/about" class="inline-flex items-center gap-4 text-sm font-bold tracking-widest uppercase text-gray-900 dark:text-white group w-fit">
            <span class="border-b border-gray-900 dark:border-white pb-1 group-hover:text-primary-600 group-hover:border-primary-600 transition-colors">
              Kenali Kami Lebih Jauh
            </span>
            <svg class="w-5 h-5 transform group-hover:translate-x-2 transition-transform text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
        
        <!-- Right Column: Visi & Misi -->
        <div class="lg:col-span-7 flex flex-col gap-12">
          
          <!-- Visi -->
          <div class="group">
            <h3 class="text-xs font-mono tracking-[0.2em] uppercase text-primary-600 dark:text-primary-400 mb-6 flex items-center gap-4">
              <span class="w-8 h-[1px] bg-primary-600/30 dark:bg-primary-400/30 group-hover:w-16 transition-all duration-500"></span>
              Visi
            </h3>
            <p class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white leading-tight tracking-tight">
              Menjadi ekosistem komunitas virtual yang dapat menaungi banyak platform serta menjadi rumah bagi seluruh pemain yang inovatif di Indonesia.
            </p>
          </div>
          
          <div class="w-full h-[1px] bg-black/10 dark:bg-white/10"></div>
          
          <!-- Misi -->
          <div class="group">
            <h3 class="text-xs font-mono tracking-[0.2em] uppercase text-primary-600 dark:text-primary-400 mb-6 flex items-center gap-4">
              <span class="w-8 h-[1px] bg-primary-600/30 dark:bg-primary-400/30 group-hover:w-16 transition-all duration-500"></span>
              Misi
            </h3>
            <ul class="space-y-6">
              <li class="flex items-start gap-6">
                <span class="text-xs font-mono text-gray-400 mt-1">01</span>
                <p class="text-lg text-gray-700 dark:text-gray-300 font-light leading-relaxed">
                  <strong class="font-medium text-gray-900 dark:text-white">Diversifikasi Pengalaman.</strong> Menyediakan wadah khusus bagi berbagai genre permainan dengan standar kualitas dan manajemen yang terjaga.
                </p>
              </li>
              <li class="flex items-start gap-6">
                <span class="text-xs font-mono text-gray-400 mt-1">02</span>
                <p class="text-lg text-gray-700 dark:text-gray-300 font-light leading-relaxed">
                  <strong class="font-medium text-gray-900 dark:text-white">Standarisasi & Profesionalitas.</strong> Menerapkan sistem manajemen komunitas yang terorganisir di setiap divisi guna menciptakan pengalaman bermain yang realistis.
                </p>
              </li>
              <li class="flex items-start gap-6">
                <span class="text-xs font-mono text-gray-400 mt-1">03</span>
                <p class="text-lg text-gray-700 dark:text-gray-300 font-light leading-relaxed">
                  <strong class="font-medium text-gray-900 dark:text-white">Inkubasi Komunitas Sehat.</strong> Membangun lingkungan yang inklusif, menghargai etika, dan mempererat solidaritas antar anggota.
                </p>
              </li>
            </ul>
          </div>
          
        </div>
        
      </div>
    </div>
  </section>

  <!-- Vision Section (Custom Dark Layout) -->
  <section class="relative min-h-[100vh] py-32 overflow-hidden bg-[#0d1117] flex items-center mt-24 lg:mt-0">
    <!-- Diagonal background element -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute w-[200%] h-[1px] bg-white/10 transform -rotate-[20deg] top-1/2 -translate-y-1/2 -left-1/2"></div>
    </div>
    
    <div class="max-w-[1400px] w-full mx-auto px-6 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Large Image + Badge -->
      <div class="lg:col-span-5 relative reveal delay-100 flex flex-col items-start xl:-ml-12">
        <div class="p-4 bg-white/5 backdrop-blur-sm shadow-[0_0_50px_rgba(0,0,0,0.5)] border border-white/10 transform -rotate-3 hover:rotate-0 transition-transform duration-700 w-full max-w-lg z-20 relative">
          <img src="https://images.nismara.my.id/web/images/nismara_transport_heavy_load.webp" alt="Character" class="w-full aspect-[4/5] object-cover grayscale-[30%] hover:grayscale-0 transition-all duration-500"/>
        </div>
        <p class="font-mono text-[10px] text-white/50 mt-4 tracking-widest uppercase ml-4">01 / Nismara Transport</p>
        
        <!-- Bottom Badge (Relative to left column) -->
        <div class="absolute -bottom-12 -right-4 lg:-right-16 w-32 h-32 rounded-full border border-white/20 flex flex-col items-center justify-center text-[9px] font-mono tracking-widest text-white/50 animate-[spin_15s_linear_infinite] hover:animate-none cursor-pointer hover:border-white/50 transition-colors z-30 bg-[#0d1117]/80 backdrop-blur-sm">
          <span class="mb-1">NISMARA</span>
          <span class="text-[#c3ff00] text-xl leading-none">✦</span>
          <span class="mt-1">WORLDS</span>
        </div>
      </div>

      <!-- Center & Right Columns: Text and smaller images -->
      <div class="lg:col-span-7 flex flex-col gap-16 mt-24 lg:mt-0">
        
        <!-- Center Text -->
        <div class="reveal z-20">
          <p class="font-mono text-[10px] md:text-xs tracking-widest text-white/60 mb-6 uppercase">One Group / Many Operations</p>
          <h1 class="text-5xl sm:text-7xl lg:text-[85px] xl:text-[95px] leading-[0.95] font-medium text-white tracking-tight mb-8">
            We don't just<br />
            play games. We<br />
            operate <span class="font-serif italic text-[#c3ff00]">enterprises.</span>
          </h1>
        </div>

        <!-- Right side images and text grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 items-end reveal delay-200 z-10">
          
          <!-- Text Paragraph -->
          <div class="order-2 sm:order-1 self-end pb-8 lg:pb-0 z-30 bg-[#0d1117]/60 lg:bg-transparent p-4 lg:p-0 rounded backdrop-blur-sm lg:backdrop-blur-none">
            <p class="text-sm md:text-base text-white/70 font-light leading-relaxed max-w-sm">
              Membangun manajemen korporat virtual dengan standar tinggi, memberikan pengalaman imersif bagi anggota di setiap sektor industri.
            </p>
          </div>
          
          <!-- Image 2 & 3 wrapper -->
          <div class="order-1 sm:order-2 flex flex-col gap-8 relative">
             <!-- Image 2 (Landscape) -->
            <div class="transform rotate-2 hover:rotate-0 transition-transform duration-700 w-full sm:-mr-8 xl:-mr-16 z-20 relative">
              <div class="p-2 bg-white/5 backdrop-blur-sm shadow-2xl border border-white/10">
                <img src="https://images.nismara.my.id/web/images/nismara_airlines_park_on_airport.webp" alt="Atmosphere" class="w-full aspect-video object-cover grayscale-[30%] hover:grayscale-0 transition-all duration-500"/>
              </div>
              <p class="font-mono text-[9px] text-white/50 mt-2 tracking-widest uppercase ml-2">02 / Nismara Airlines</p>
            </div>

            <!-- Image 3 (Portrait) -->
            <div class="transform -rotate-2 hover:rotate-0 transition-transform duration-700 w-3/4 ml-auto sm:-mb-16 z-10 relative">
              <div class="p-2 bg-white/5 backdrop-blur-sm shadow-2xl border border-white/10">
                <!-- Placeholder using existing image, replace later -->
                <img src="https://images.nismara.my.id/web/images/nismara_transport_coach.webp" alt="Action" class="w-full aspect-[3/4] object-cover grayscale-[30%] hover:grayscale-0 transition-all duration-500"/>
              </div>
              <p class="font-mono text-[9px] text-white/50 mt-2 tracking-widest uppercase ml-2">03 / Nismara Coach</p>
            </div>
          </div>
          
        </div>
      </div>
      
    </div>
  </section>

  <!-- Scrollytelling Showcase Section (Horizontal Scroll) -->
  <section id="showcase-horizontal" class="relative h-[400vh] bg-[#050505] text-white">
    <div class="sticky top-0 h-screen w-full overflow-hidden">
      <!-- Interactive Background Canvas -->
      <canvas id="particles-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>
      <!-- Track -->
      <div id="horizontal-track" class="flex w-[300vw] h-full will-change-transform transition-transform ease-out duration-75 relative z-10">
        
        <!-- Slide 1: Transport -->
        <div class="w-screen h-full flex items-center justify-center relative flex-shrink-0">
          <div class="max-w-[1400px] w-full mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="pr-0 lg:pr-12">
              <div class="flex flex-wrap items-center gap-4 mb-4">
                <p class="text-[#c3ff00] font-mono text-xs md:text-sm tracking-widest uppercase m-0">01 / Logistics & Transit</p>
                <span class="px-2 py-1 bg-green-500/10 text-green-400 border border-green-500/20 text-[10px] font-mono uppercase tracking-widest rounded-sm">[ ACTIVE ]</span>
              </div>
              <h2 class="text-5xl md:text-6xl font-bold mb-6 text-white tracking-tight">Nismara Transport</h2>
              <p class="text-white/60 text-lg md:text-xl font-light leading-relaxed max-w-lg">
                Menyediakan solusi mobilitas yang andal dan efisien. Nismara Transport adalah pilar pergerakan logistik modern yang menghubungkan berbagai titik krusial di seluruh negeri dengan kecepatan dan keamanan tanpa kompromi.
              </p>
            </div>
            <div class="w-full aspect-[4/5] lg:aspect-square rounded overflow-hidden shadow-2xl bg-white/5 border border-white/10">
              <img src="/images/nismara-transport.jpg" class="w-full h-full object-cover" alt="Nismara Transport" />
            </div>
          </div>
        </div>
        
        <!-- Slide 2: Racing -->
        <div class="w-screen h-full flex items-center justify-center relative flex-shrink-0">
          <div class="max-w-[1400px] w-full mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="pr-0 lg:pr-12">
              <div class="flex flex-wrap items-center gap-4 mb-4">
                <p class="text-[#c3ff00] font-mono text-xs md:text-sm tracking-widest uppercase m-0">02 / Adrenaline & Precision</p>
                <span class="px-2 py-1 bg-green-500/10 text-green-400 border border-green-500/20 text-[10px] font-mono uppercase tracking-widest rounded-sm">[ ACTIVE ]</span>
              </div>
              <h2 class="text-5xl md:text-6xl font-bold mb-6 text-white tracking-tight">Nismara Racing</h2>
              <p class="text-white/60 text-lg md:text-xl font-light leading-relaxed max-w-lg">
                Mendefinisikan ulang batasan kecepatan. Divisi Racing kami menggabungkan rekayasa teknologi tinggi dan semangat kompetisi untuk menciptakan mesin-mesin juara di lintasan balap internasional.
              </p>
            </div>
            <div class="w-full aspect-[4/5] lg:aspect-square rounded overflow-hidden shadow-2xl bg-white/5 border border-white/10">
              <img src="/images/nismara-racing.webp" class="w-full h-full object-cover" alt="Nismara Racing" />
            </div>
          </div>
        </div>

        <!-- Slide 3: Airlines -->
        <div class="w-screen h-full flex items-center justify-center relative flex-shrink-0">
          <div class="max-w-[1400px] w-full mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="pr-0 lg:pr-12">
              <div class="flex flex-wrap items-center gap-4 mb-4">
                <p class="text-[#c3ff00] font-mono text-xs md:text-sm tracking-widest uppercase m-0">03 / Aviation & Comfort</p>
                <span class="px-2 py-1 bg-green-500/10 text-green-400 border border-green-500/20 text-[10px] font-mono uppercase tracking-widest rounded-sm">[ ACTIVE ]</span>
              </div>
              <h2 class="text-5xl md:text-6xl font-bold mb-6 text-white tracking-tight">Nismara Airlines</h2>
              <p class="text-white/60 text-lg md:text-xl font-light leading-relaxed max-w-lg">
                Menaklukkan langit dengan kemewahan dan keselamatan. Nismara Airlines memberikan pengalaman terbang berkelas dunia, memadukan pelayanan superior dengan armada aviasi generasi terbaru.
              </p>
            </div>
            <div class="w-full aspect-[4/5] lg:aspect-square rounded overflow-hidden shadow-2xl bg-white/5 border border-white/10">
              <img src="/images/nismara-airlines.webp" class="w-full h-full object-cover" alt="Nismara Airlines" />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
  <!-- Marquee Banner (Ticker) -->
  <div class="w-full bg-[#f3f4f6] dark:bg-[#0c1017] overflow-hidden py-4 border-b border-black/5 dark:border-white/5">
    <div class="flex whitespace-nowrap w-max animate-marquee">
      <!-- First Block -->
      <div class="flex items-center space-x-12 px-6">
        {Array.from({ length: 20 }).map(() => (
          <span class="text-sm md:text-base font-light tracking-[0.3em] text-black/40 dark:text-white/40 uppercase">
            Nismara Group
          </span>
        ))}
      </div>
      <!-- Second Block (Duplicate for seamless loop) -->
      <div class="flex items-center space-x-12 px-6">
        {Array.from({ length: 20 }).map(() => (
          <span class="text-sm md:text-base font-light tracking-[0.3em] text-black/40 dark:text-white/40 uppercase">
            Nismara Group
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Live Statistics Section -->
  <section class="py-24 bg-white dark:bg-[#050505] transition-colors border-b border-black/5 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-primary-600 dark:text-primary-500 mb-4">Live Operations</p>
        <h2 class="text-3xl md:text-4xl font-light text-gray-900 dark:text-white tracking-tight">Corporate Statistics</h2>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 reveal delay-100">
        <!-- Stat 1 -->
        <div class="flex flex-col items-center text-center">
          <span class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-2 tracking-tighter">3+</span>
          <span class="text-xs md:text-sm font-mono tracking-widest text-gray-500 uppercase">Active Divisions</span>
        </div>
        <!-- Stat 2 -->
        <div class="flex flex-col items-center text-center">
          <span class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-2 tracking-tighter">150+</span>
          <span class="text-xs md:text-sm font-mono tracking-widest text-gray-500 uppercase">Active Members</span>
        </div>
        <!-- Stat 3 -->
        <div class="flex flex-col items-center text-center">
          <span class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-2 tracking-tighter">17+</span>
          <span class="text-xs md:text-sm font-mono tracking-widest text-gray-500 uppercase">Professional Staffs</span>
        </div>
        <!-- Stat 4 -->
        <div class="flex flex-col items-center text-center">
          <span class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-2 tracking-tighter">24/7</span>
          <span class="text-xs md:text-sm font-mono tracking-widest text-gray-500 uppercase">Active Operations</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Impact Section (Axis Inspired) -->
  <section class="relative bg-[#f4f4f0] dark:bg-[#0a0f1a] overflow-hidden pt-32 pb-32 transition-colors duration-500">
    <!-- Grid Lines (Background) -->
    <div class="absolute inset-0 pointer-events-none z-0 flex justify-center">
      <!-- Horizontal line -->
      <div class="absolute top-[20%] lg:top-[30%] w-full h-[1px] bg-black/10 dark:bg-white/10"></div>
      <!-- Vertical line -->
      <div class="absolute top-0 bottom-0 left-6 md:left-[15%] w-[1px] bg-black/10 dark:bg-white/10"></div>
      <!-- Crosshair dot on intersection -->
      <div class="absolute top-[20%] lg:top-[30%] left-6 md:left-[15%] w-2 h-2 rounded-full border border-primary-600 bg-[#f4f4f0] dark:bg-[#0a0f1a] -translate-x-1/2 -translate-y-1/2"></div>
    </div>

    <div class="max-w-[1400px] mx-auto px-6 relative z-10">
      
      <!-- Center Graphic: Circle N + Wrapped text -->
      <div class="flex flex-col items-center justify-center mb-6 lg:mb-10 reveal">
        <div class="relative w-32 h-32 flex items-center justify-center">
          <!-- Outer rotating text (SVG) -->
          <svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full animate-[spin_20s_linear_infinite] opacity-60 dark:opacity-40">
            <path id="circlePath" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="transparent" />
            <text class="text-[10px] font-mono tracking-[0.2em] uppercase fill-gray-900 dark:fill-white font-bold">
              <textPath href="#circlePath" startOffset="0%">Integrity • Synergy • Growth •</textPath>
            </text>
          </svg>
          <!-- Inner solid circle -->
          <div class="w-16 h-16 bg-gray-900 dark:bg-white text-[#f4f4f0] dark:text-[#0a0f1a] rounded-full flex items-center justify-center relative overflow-hidden group cursor-pointer transition-transform duration-500 hover:scale-110 shadow-lg">
             <!-- Slash line across the circle -->
             <div class="absolute w-[150%] h-[2px] bg-primary-600 rotate-45 group-hover:rotate-[225deg] transition-transform duration-700 ease-in-out"></div>
             <!-- Nismara SVG (Inverted in dark mode because the circle becomes white) -->
             <img src="/nismara.svg" alt="Nismara Logo" class="w-8 h-8 object-contain relative z-10 dark:invert transition-transform duration-500 group-hover:scale-110" />
          </div>
        </div>
      </div>

      <!-- Giant Header -->
      <div class="text-center mb-32 reveal delay-100 flex flex-col items-center">
        <div class="relative inline-block group cursor-default">
          <h2 class="text-[18vw] md:text-[15vw] leading-[0.8] font-bold tracking-tighter text-primary-600 dark:text-primary-500 uppercase">
            NISMARA
          </h2>
          <!-- "WORLD" Text -->
          <div class="absolute -bottom-6 right-2 md:-bottom-8 md:-right-8 lg:-right-12 z-20">
