  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Horizontal Scrollytelling Logic
      const section = document.getElementById('showcase-horizontal');
      const track = document.getElementById('horizontal-track');
      
      if (section && track) {
        let isScrolling = false;
        
        const handleScroll = () => {
          if (!isScrolling) {
            window.requestAnimationFrame(() => {
              const rect = section.getBoundingClientRect();
              const windowHeight = window.innerHeight;
              
              let progress = 0;
              // If top of section is above or at top of viewport
              if (rect.top <= 0) {
                const scrollableDistance = rect.height - windowHeight;
                // Calculate progress from 0 to 1
                progress = Math.min(1, Math.max(0, -rect.top / scrollableDistance));
              }
              
              // Map progress to translate: finish translating at 75% of the scroll (progress * 1.3333)
              const translateProgress = Math.min(1, progress * 1.3333);
              // 3 slides = total width 300%. To see the last slide, we translate by -66.666%
              const translateValue = translateProgress * -66.6666;
              track.style.transform = `translateX(${translateValue}%)`;
              
              isScrolling = false;
            });
            isScrolling = true;
          }
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
        // Initial call in case page is loaded already scrolled
        handleScroll();
      }

      // Interactive Particles System
      const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement | null;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let width = 0, height = 0;
        let mouse = { x: -1000, y: -1000, radius: 150 };

        class Particle {
          x: number;
          y: number;
          size: number;
          baseX: number;
          baseY: number;
          density: number;
          color: string;

          constructor() {
            this.x = Math.random() * width;
            this.y = Math.random() * height;
            // Larger particles
            this.size = Math.random() * 3 + 1.5;
            this.baseX = this.x;
            this.baseY = this.y;
            this.density = (Math.random() * 20) + 1;
            // Brighter particles
            this.color = `rgba(255, 255, 255, ${Math.random() * 0.5 + 0.2})`;
          }

          draw() {
            if (!ctx) return;
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.closePath();
            ctx.fill();
          }

          update() {
            let dx = mouse.x - this.x;
            let dy = mouse.y - this.y;
            let distance = Math.sqrt(dx * dx + dy * dy);
            let forceDirectionX = dx / distance;
            let forceDirectionY = dy / distance;
            let maxDistance = mouse.radius;
            let force = (maxDistance - distance) / maxDistance;
            let directionX = forceDirectionX * force * this.density;
            let directionY = forceDirectionY * force * this.density;

            if (distance < mouse.radius) {
              this.x -= directionX;
              this.y -= directionY;
            } else {
              if (this.x !== this.baseX) {
                let dx = this.x - this.baseX;
                this.x -= dx / 20;
              }
              if (this.y !== this.baseY) {
                let dy = this.y - this.baseY;
                this.y -= dy / 20;
              }
            }
          }
        }

        let particles: Particle[] = [];

        const initCanvas = () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
          particles = [];
          // Increase particle count for a denser field
          for (let i = 0; i < 120; i++) {
            particles.push(new Particle());
          }
        };

        const animate = () => {
          if (!ctx) return;
          ctx.clearRect(0, 0, width, height);
          for (let i = 0; i < particles.length; i++) {
            particles[i].draw();
            particles[i].update();
          }
          requestAnimationFrame(animate);
        };

        initCanvas();
        animate();

        window.addEventListener('resize', initCanvas);
        
        // Track mouse movement across the document
        document.addEventListener('mousemove', (e) => {
          if (!section) return;
          const rect = section.getBoundingClientRect();
          // Only interact if the mouse is over the section
          if (e.clientY >= rect.top && e.clientY <= rect.bottom) {
             // Position relative to the sticky canvas
             mouse.x = e.clientX;
             mouse.y = e.clientY - Math.max(0, rect.top);
          } else {
             mouse.x = -1000;
             mouse.y = -1000;
          }
        });
      }
    });
  </script>
