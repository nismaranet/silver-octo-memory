---
import Layout from '../layouts/Layout.astro';
import { urlFor } from '../utils/sanity';

// Hardcoded data for the divisions since this is a static showcase.
const divisions = [
  {
    name: 'Nismara Transport',
    category: 'Logistics & Passenger',
    description: 'Divisi utama yang mengelola jaringan logistik darat dan transportasi penumpang skala besar dengan presisi dan efisiensi tingkat tinggi.',
    url: 'https://transport.nismara.web.id',
    image: '/images/nismara-transport.jpg'
  },
  {
    name: 'Nismara Airlines',
    category: 'Aviation Division',
    description: 'Menjelajah langit tak berbatas. Membawa kargo dan penumpang mengarungi rute udara dengan armada pesawat komersial virtual modern.',
    url: '#',
    image: '/images/nismara-airlines.webp'
  },
  {
    name: 'Nismara Racing',
    category: 'Motorsport Division',
    description: 'Divisi motorsport yang membara. Meraih waktu putaran tercepat, merancang strategi pit stop yang sempurna, dan menguasai sirkuit.',
    url: 'https://racing.nismara.web.id',
    image: '/images/nismara-racing.webp'
  },
  {
    name: 'Nismara World',
    category: 'Gaming Ecosystem',
    description: 'Kumpulan sub-divisi untuk permainan dunia terbuka dan simulasi spesifik. Terdiri dari Rice Kencur (Minecraft), BLCK (GTA V & Action), dan Nismara Farm (Farming Simulator).',
    url: '#',
    image: '/images/farming-simulator.webp'
  }
];

const directors = [
  {
    name: 'TBA',
    role: 'Chief Executive Officer',
    image: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'TBA',
    role: 'Chief Operating Officer',
    image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=400&auto=format&fit=crop'
  }
];

const staff = [
  {
    name: 'TBA',
    role: 'Transport Manager',
    image: 'https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'TBA',
    role: 'Airlines Manager',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'TBA',
    role: 'Racing Director',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'TBA',
    role: 'Community Lead',
    image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=400&auto=format&fit=crop'
  }
];
---

<Layout title="About Us - Nismara Group">
  <main class="bg-white dark:bg-[#050505] transition-colors min-h-screen pt-32">
    
    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center px-6 pb-24 overflow-hidden border-b border-black/10 dark:border-white/10">

      <div class="max-w-7xl mx-auto w-full text-center relative z-10 reveal">
        <p class="text-xs font-mono tracking-[0.3em] uppercase text-gray-500 mb-8">Virtual Simulation Ecosystem</p>
        <img src="/images/nismara-group-logo.png" alt="Nismara Group" class="mx-auto w-auto max-w-[80vw] md:max-w-xl mb-12" />
        <p class="text-lg md:text-2xl text-gray-600 dark:text-gray-400 font-light max-w-2xl mx-auto leading-relaxed">
          Membangun batas baru di dunia maya melalui manajemen profesional, komunitas solid, dan kecintaan pada simulasi.
        </p>
      </div>
    </section>

    <!-- The Story / Manifesto -->
    <section class="py-32 px-6 bg-gray-50 dark:bg-[#0a0a0a] transition-colors border-b border-black/10 dark:border-white/10">
      <div class="max-w-4xl mx-auto reveal">
        <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-primary-600 dark:text-primary-400 mb-12">The Manifesto</p>
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-light text-gray-900 dark:text-white leading-[1.2] tracking-tight mb-16">
          Berawal dari kecintaan yang murni terhadap dunia permainan simulasi, kami menyadari bahwa <span class="font-medium text-black dark:text-white">simulasi bukan sekadar pelarian</span>, melainkan sebuah wadah untuk menciptakan keteraturan, melatih ketelitian, dan berkolaborasi dalam sebuah orkestra virtual.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-lg text-gray-600 dark:text-gray-400 font-light leading-relaxed">
          <p>
            Nismara Group tidak terlahir di sebuah gedung bertingkat, melainkan di dalam <em>voice channel</em> dan server komunitas. Kami melihat bahwa ribuan orang menghabiskan ratusan jam mengemudikan truk di tengah malam, mengatur jadwal penerbangan menembus awan, hingga merawat lahan pertanian virtual.
          </p>
          <p>
            Kami membingkai <em>passion</em> tersebut ke dalam sebuah ekosistem perusahaan virtual. Nismara hadir untuk memberikan identitas, profesionalisme, dan rumah bagi mereka yang mencari pengalaman bermain simulasi di level yang sama sekali berbeda.
          </p>
        </div>
      </div>
    </section>

    <!-- Visi & Misi Section -->
    <section class="py-32 px-6 bg-white dark:bg-[#050505] transition-colors border-b border-black/10 dark:border-white/10">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-24">
          <!-- Visi -->
          <div class="reveal">
            <h3 class="text-xs font-mono tracking-[0.2em] uppercase text-gray-400 dark:text-gray-600 mb-8">01 / Visi</h3>
            <p class="text-4xl md:text-5xl font-medium text-gray-900 dark:text-white leading-[1.1] tracking-tight">
              Menjadi wadah ekosistem virtual terdepan yang menaungi berbagai divisi simulasi dan gaming demi menyatukan para penggemar dalam satu atap yang solid.
            </p>
          </div>
          <!-- Misi -->
          <div class="reveal delay-100">
            <h3 class="text-xs font-mono tracking-[0.2em] uppercase text-gray-400 dark:text-gray-600 mb-8">02 / Misi</h3>
            <ul class="flex flex-col gap-12">
              <li class="relative pl-8 before:absolute before:left-0 before:top-2 before:w-4 before:h-[1px] before:bg-primary-600">
                <h4 class="text-2xl font-medium text-gray-900 dark:text-white mb-3">Manajemen Profesional</h4>
                <p class="text-gray-600 dark:text-gray-400 font-light leading-relaxed">
                  Membangun dan mengembangkan perusahaan virtual profesional (Nismara Transport, Airlines, Racing) untuk menghadirkan pengalaman bermain simulasi yang realistis.
                </p>
              </li>
              <li class="relative pl-8 before:absolute before:left-0 before:top-2 before:w-4 before:h-[1px] before:bg-primary-600">
                <h4 class="text-2xl font-medium text-gray-900 dark:text-white mb-3">Fasilitas Komunitas</h4>
                <p class="text-gray-600 dark:text-gray-400 font-light leading-relaxed">
                  Memfasilitasi ruang bermain terbuka melalui sub-divisi Nismara World di berbagai platform game populer.
                </p>
              </li>
              <li class="relative pl-8 before:absolute before:left-0 before:top-2 before:w-4 before:h-[1px] before:bg-primary-600">
                <h4 class="text-2xl font-medium text-gray-900 dark:text-white mb-3">Persaudaraan Digital</h4>
                <p class="text-gray-600 dark:text-gray-400 font-light leading-relaxed">
                  Mendorong kreativitas dan ikatan sosial antar anggota melalui integrasi teknologi, acara internal, dan budaya kekeluargaan.
                </p>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- The Ecosystem / Divisions -->
    <section class="py-32 px-6 bg-gray-50 dark:bg-[#0a0f1a] transition-colors overflow-hidden border-b border-black/10 dark:border-white/10">
      <div class="max-w-7xl mx-auto mb-24 reveal">
        <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-primary-600 dark:text-primary-400 mb-4">The Ecosystem</p>
        <h2 class="text-4xl md:text-6xl font-light text-gray-900 dark:text-white tracking-tight">Divisions & Sub-Brands</h2>
      </div>

      <div class="max-w-7xl mx-auto flex flex-col border-b border-black/10 dark:border-white/10">
        {divisions.map((div, i) => (
          <div class={`group border-t border-black/10 dark:border-white/10 py-12 md:py-16 flex flex-col lg:flex-row gap-12 lg:items-center reveal delay-${(i % 3) * 100}`}>
            
            <!-- Left Info -->
            <div class="lg:w-1/3 flex flex-col">
              <span class="text-[10px] font-mono tracking-widest text-gray-400 mb-6 uppercase">0{i + 1} // {div.category}</span>
              <h3 class="text-4xl lg:text-5xl font-medium text-gray-900 dark:text-white tracking-tighter mb-6 group-hover:text-primary-600 transition-colors">
                {div.name}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 font-light text-lg mb-8 leading-relaxed max-w-sm">
                {div.description}
              </p>
              {div.url !== '#' && (
                <a href={div.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-4 text-sm font-bold tracking-widest uppercase text-gray-900 dark:text-white group-hover:text-primary-600 w-fit">
                  <span class="border-b border-gray-900 dark:border-white pb-1 group-hover:border-primary-600 transition-colors">Kunjungi Portal</span>
                  <svg class="w-4 h-4 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              )}
            </div>

            <!-- Right Image -->
            <div class="lg:w-2/3 h-[300px] lg:h-[450px] overflow-hidden bg-black/5 dark:bg-white/5 rounded-sm relative">
              <img src={div.image} alt={div.name} class="w-full h-full object-cover grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-[1.5s] ease-out" />
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-32 px-6 bg-white dark:bg-[#050505] transition-colors border-b border-black/10 dark:border-white/10 overflow-hidden">
      <div class="max-w-7xl mx-auto">
        
        <!-- Meet the Directors -->
        <div class="mb-32 reveal">
          <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-primary-600 dark:text-primary-400 mb-4">Leadership</p>
          <h2 class="text-4xl md:text-5xl font-light text-gray-900 dark:text-white tracking-tight mb-16">Meet the Directors</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {directors.map((person, i) => (
              <div class={`group flex flex-col gap-6 reveal delay-${(i % 4) * 100}`}>
                <div class="aspect-[3/4] w-full overflow-hidden bg-gray-100 dark:bg-gray-900 rounded-sm">
                  <img src={person.image} alt={person.name} class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
                </div>
                <div>
                  <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-1 tracking-tight">{person.name}</h3>
                  <p class="text-sm font-mono text-gray-500 uppercase tracking-wider">{person.role}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Our Proud Staff -->
        <div class="reveal">
          <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-primary-600 dark:text-primary-400 mb-4">The Team</p>
          <h2 class="text-4xl md:text-5xl font-light text-gray-900 dark:text-white tracking-tight mb-16">Our Proud Staff</h2>
          
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-12 md:gap-8">
            {staff.map((person, i) => (
              <div class={`group flex flex-col gap-4 reveal delay-${(i % 4) * 100}`}>
                <div class="aspect-square w-full overflow-hidden bg-gray-100 dark:bg-gray-900 rounded-sm rounded-tl-[2rem] rounded-br-[2rem]">
                  <img src={person.image} alt={person.name} class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
                </div>
                <div class="text-center">
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-1 tracking-tight">{person.name}</h3>
                  <p class="text-[10px] md:text-xs font-mono text-gray-500 uppercase tracking-wider">{person.role}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-32 px-6 bg-white dark:bg-[#050505] transition-colors relative flex items-center justify-center text-center overflow-hidden">
      <div class="relative z-10 max-w-4xl mx-auto reveal">
        <h2 class="text-5xl md:text-7xl font-bold tracking-tighter text-gray-900 dark:text-white uppercase mb-8">Siap Mengaspal Bersama?</h2>
        <p class="text-xl md:text-2xl text-gray-500 dark:text-gray-400 font-light max-w-2xl mx-auto mb-12 leading-relaxed">
          Baik Anda seorang pengemudi virtual veteran maupun pemain kasual yang mencari komunitas ramah, selalu ada kursi kosong untuk Anda.
        </p>
        <a href="#" class="inline-flex items-center gap-4 px-10 py-5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 hover:scale-105 transition-transform duration-300 font-medium tracking-wide">
          Bergabung Sekarang
        </a>
      </div>
    </section>
    
  </main>
</Layout>
