---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'Apakah bergabung di Nismara Group dipungut biaya?',
    a: 'Sama sekali tidak. Nismara Group adalah komunitas virtual gratis yang berfokus pada pengalaman simulasi tingkat tinggi dan persaudaraan.'
  },
  {
    q: 'Bagaimana cara bergabung dengan divisi tertentu?',
    a: 'Anda bisa mengunjungi halaman "Join Us" atau langsung mengakses tautan undangan Discord kami. Staf divisi terkait akan memandu proses rekrutmen Anda di sana.'
  },
  {
    q: 'Apakah saya bisa mengajukan kerja sama bisnis atau sponsorship?',
    a: 'Tentu saja. Anda dapat menghubungi kami melalui email support@nismara.web.id atau mengirim pesan melalui formulir di atas dengan subjek "Business / Partnership".'
  },
  {
    q: 'Saya mengalami masalah teknis saat mengakses layanan Nismara.',
    a: 'Untuk respons tercepat, silakan masuk ke server Discord kami dan buat tiket bantuan (support ticket) di kanal yang telah disediakan. Tim dukungan teknis kami siap membantu 24/7.'
  }
];
---

<Layout title="Contact Us - Nismara Group">
  <main class="bg-white dark:bg-black transition-colors min-h-screen pt-32">
    <!-- Hero Section -->
    <section class="py-24 px-6 relative overflow-hidden">
      <div class="max-w-4xl mx-auto text-center reveal">
        <h1 class="text-6xl md:text-8xl font-bold tracking-tighter text-gray-900 dark:text-white uppercase mb-8">
          Let's Talk
        </h1>
        <p class="text-lg md:text-xl text-gray-500 dark:text-gray-400 font-light leading-relaxed max-w-2xl mx-auto">
          Punya pertanyaan tentang ekosistem Nismara? Atau tertarik menjalin kemitraan? Tim operasional kami selalu siap mendengar dan merespons Anda.
        </p>
      </div>
    </section>

    <!-- Contact Grid -->
    <section class="py-16 px-6">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
        
        <!-- Left: Contact Info -->
        <div class="flex flex-col gap-12 reveal delay-100">
          <div>
            <h3 class="text-xs font-mono uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-4">Direct Email</h3>
            <a href="mailto:support@nismara.web.id" class="text-3xl md:text-5xl font-medium tracking-tight text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors break-words">
              support@nismara.web.id
            </a>
            <p class="mt-6 text-gray-500 dark:text-gray-400 font-light leading-relaxed">
              Ideal untuk keperluan administratif, kerja sama media, proposal sponsorship, atau pertanyaan kemitraan bisnis resmi.
            </p>
          </div>

          <hr class="border-gray-200 dark:border-gray-800" />

          <div>
            <h3 class="text-xs font-mono uppercase tracking-widest text-indigo-500 mb-4">Community Server</h3>
            <a href="https://link.nismara.web.id/discord" target="_blank" class="inline-flex items-center gap-4 text-2xl md:text-4xl font-medium tracking-tight text-gray-900 dark:text-white hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors break-words">
              Discord Headquarters
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <p class="mt-6 text-gray-500 dark:text-gray-400 font-light leading-relaxed">
              Cara tercepat untuk mendapatkan bantuan terkait rekrutmen anggota baru, bantuan teknis server, atau sekadar berbincang santai dengan staf kami.
            </p>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="bg-gray-50 dark:bg-gray-900 p-8 md:p-12 rounded-xl reveal delay-200 border border-gray-100 dark:border-gray-800 shadow-xl shadow-black/5 dark:shadow-none">
          <form class="flex flex-col gap-10" onsubmit="event.preventDefault(); alert('Pesan berhasil terkirim! (Simulasi UI. Nismara Group akan segera merespons).');">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
              <div class="flex flex-col gap-3">
                <label for="name" class="text-xs font-mono uppercase tracking-widest text-gray-500">Nama Anda</label>
                <input type="text" id="name" required class="bg-transparent border-b border-gray-300 dark:border-gray-700 py-3 text-gray-900 dark:text-white focus:outline-none focus:border-primary-600 dark:focus:border-primary-400 transition-colors placeholder-gray-400 dark:placeholder-gray-600" placeholder="Cth: Budi Santoso" />
              </div>
              <div class="flex flex-col gap-3">
                <label for="email" class="text-xs font-mono uppercase tracking-widest text-gray-500">Alamat Email</label>
                <input type="email" id="email" required class="bg-transparent border-b border-gray-300 dark:border-gray-700 py-3 text-gray-900 dark:text-white focus:outline-none focus:border-primary-600 dark:focus:border-primary-400 transition-colors placeholder-gray-400 dark:placeholder-gray-600" placeholder="budi@example.com" />
              </div>
            </div>

            <div class="flex flex-col gap-3">
              <label for="subject" class="text-xs font-mono uppercase tracking-widest text-gray-500">Subjek / Topik</label>
              <select id="subject" class="bg-transparent border-b border-gray-300 dark:border-gray-700 py-3 text-gray-900 dark:text-white focus:outline-none focus:border-primary-600 dark:focus:border-primary-400 transition-colors appearance-none cursor-pointer rounded-none">
                <option value="general" class="dark:bg-gray-900">Pertanyaan Umum (General)</option>
                <option value="recruitment" class="dark:bg-gray-900">Rekrutmen & Pendaftaran</option>
                <option value="business" class="dark:bg-gray-900">Kerja Sama & Kemitraan (Business)</option>
                <option value="tech" class="dark:bg-gray-900">Bantuan Teknis Khusus</option>
              </select>
            </div>

            <div class="flex flex-col gap-3">
              <label for="message" class="text-xs font-mono uppercase tracking-widest text-gray-500">Pesan Utama</label>
              <textarea id="message" rows="4" required class="bg-transparent border-b border-gray-300 dark:border-gray-700 py-3 text-gray-900 dark:text-white focus:outline-none focus:border-primary-600 dark:focus:border-primary-400 transition-colors resize-none placeholder-gray-400 dark:placeholder-gray-600" placeholder="Tuliskan pesan Anda secara detail..."></textarea>
            </div>

            <button type="submit" class="mt-4 px-10 py-5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-bold uppercase tracking-widest hover:bg-primary-600 dark:hover:bg-primary-400 hover:text-white transition-all transform hover:-translate-y-1 w-full md:w-auto self-start shadow-lg">
              Kirim Pesan
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-32 px-6 border-t border-gray-100 dark:border-gray-900 mt-16 bg-gray-50 dark:bg-gray-950 transition-colors">
      <div class="max-w-4xl mx-auto reveal">
        <h2 class="text-3xl md:text-5xl font-medium tracking-tight text-gray-900 dark:text-white mb-16 text-center">
          Frequently Asked Questions
        </h2>
        
        <div class="flex flex-col divide-y divide-gray-200 dark:divide-gray-800">
          {faqs.map(faq => (
            <div class="py-8 group cursor-default sm:cursor-pointer hover:bg-white/50 dark:hover:bg-black/20 transition-colors -mx-6 px-6 rounded-lg">
              <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-4 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {faq.q}
              </h3>
              <p class="text-gray-500 dark:text-gray-400 leading-relaxed font-light">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
</Layout>
