---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404: Page Not Found | Nismara Group" 
  description="Oops! The page you are looking for does not exist."
>
  <main class="min-h-[80vh] flex items-center justify-center bg-white dark:bg-[#050505] transition-colors duration-500 px-6 pt-20">
    <div class="text-center max-w-2xl mx-auto reveal">
      <div class="inline-block mb-6 px-4 py-1.5 rounded-full bg-red-100 dark:bg-red-900/30 border border-red-200 dark:border-red-800/50">
        <span class="text-sm font-mono tracking-widest uppercase text-red-600 dark:text-red-400">Error 404</span>
      </div>
      
      <h1 class="text-8xl md:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gray-900 to-gray-500 dark:from-white dark:to-gray-600 mb-6 tracking-tighter">
        404
      </h1>
      
      <h2 class="text-3xl md:text-4xl font-light text-gray-900 dark:text-white mb-6 tracking-tight">
        Lost in the <span class="font-semibold">Virtual Space?</span>
      </h2>
      
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-12 leading-relaxed font-light">
        We can't seem to find the page you're looking for. The simulation might be rendering, or the page has been moved to a different sector.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/" 
          class="px-8 py-4 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium hover:scale-105 transition-transform duration-300 shadow-xl shadow-gray-900/20 dark:shadow-white/10"
        >
          Return to Base
        </a>
        <a 
          href="/articles" 
          class="px-8 py-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white font-medium hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors duration-300"
        >
          Read Latest News
        </a>
      </div>
    </div>
  </main>
</Layout>
