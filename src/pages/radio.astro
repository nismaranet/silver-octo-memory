---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nismara Radio - Live Broadcast Nismara Group" description="Dengarkan siaran langsung Nismara Radio. Aktif 24/7. Kamu juga bisa dengarkan langsung di game Euro Truck Simulator 2 & American Truck Simulator." noPaddingTop={true} animeFooter={true}>
  <section class="relative min-h-screen flex flex-col justify-start overflow-hidden bg-gray-50 dark:bg-[#0a0f1a] pt-32 lg:pt-40 pb-20 transition-colors duration-500">
    <!-- Animated Background -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div id="bg-blur" class="absolute inset-0 bg-cover bg-center bg-no-repeat blur-3xl opacity-20 dark:opacity-20 transition-all duration-1000 scale-110" style="background-image: url('https://images.nismara.my.id/web/images/nismara_airlines_park_on_airport.webp');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-gray-50 via-gray-50/80 to-gray-50/40 dark:from-[#0a0f1a] dark:via-[#0a0f1a]/80 dark:to-[#0a0f1a]/40 transition-colors duration-500"></div>
      
      <!-- Floating Music Notes -->
      <div id="floating-notes" class="absolute inset-0 opacity-0 transition-opacity duration-1000">
        <!-- Left Side Notes -->
        <div class="music-note note-l1 text-primary-500/40 dark:text-primary-400/30">♪</div>
        <div class="music-note note-l2 text-blue-500/40 dark:text-blue-400/30">♫</div>
        <div class="music-note note-l3 text-purple-500/40 dark:text-purple-400/30">♬</div>
        <div class="music-note note-l4 text-pink-500/40 dark:text-pink-400/30">♪</div>
        <div class="music-note note-l5 text-indigo-500/40 dark:text-indigo-400/30">♫</div>
        <div class="music-note note-l6 text-teal-500/40 dark:text-teal-400/30">♬</div>
        <div class="music-note note-l7 text-red-500/40 dark:text-red-400/30">♪</div>
        
        <!-- Right Side Notes -->
        <div class="music-note note-r1 text-indigo-500/40 dark:text-indigo-400/30">♫</div>
        <div class="music-note note-r2 text-primary-500/40 dark:text-primary-400/30">♬</div>
        <div class="music-note note-r3 text-pink-500/40 dark:text-pink-400/30">♪</div>
        <div class="music-note note-r4 text-blue-500/40 dark:text-blue-400/30">♫</div>
        <div class="music-note note-r5 text-purple-500/40 dark:text-purple-400/30">♬</div>
        <div class="music-note note-r6 text-teal-500/40 dark:text-teal-400/30">♪</div>
        <div class="music-note note-r7 text-red-500/40 dark:text-red-400/30">♫</div>
      </div>
    </div>

    <div class="relative z-10 w-full max-w-5xl mx-auto p-6">
      
      <!-- Branding Header -->
      <div class="text-center mb-12 lg:mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 dark:bg-white/5 border border-gray-200 dark:border-white/10 backdrop-blur-md mb-6 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
          </span>
          <span class="text-[11px] font-mono tracking-[0.2em] text-gray-800 dark:text-gray-200 uppercase font-bold">On Air 24/7</span>
        </div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-gray-900 dark:text-white tracking-tighter mb-6">
          Nismara <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-blue-500">Radio</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
          Saluran hiburan audio resmi Nismara Group. Dengarkan siaran langsung, temukan musik baru, dan temani perjalanan <span class="italic">virtual trucking</span> Anda dengan kualitas suara terbaik.
        </p>
      </div>

      <!-- Main Layout Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Radio Player -->
      <div class="lg:col-span-6 xl:col-span-5 flex flex-col gap-8">
        <!-- Radio Player Container -->
        <div class="backdrop-blur-2xl bg-white/40 dark:bg-white/5 border border-white/60 dark:border-white/10 rounded-[2.5rem] p-8 shadow-xl dark:shadow-2xl flex flex-col items-center relative overflow-hidden transition-colors duration-500">
          
          <!-- Subtle Glow Effect -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-primary-600/10 dark:bg-primary-600/20 blur-[50px] rounded-full pointer-events-none"></div>

          <!-- Header: Live Badge & Listeners -->
          <div class="flex items-center justify-between w-full mb-8 z-10 px-2">
            <div class="flex items-center gap-2 px-3 py-1.5 bg-red-500/10 border border-red-500/20 rounded-full">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-[pulse_2s_cubic-bezier(0.4,0,0.6,1)_infinite]"></span>
              <span class="text-[9px] font-mono font-bold tracking-[0.2em] uppercase text-red-500 dark:text-red-400 mt-px">Live Broadcast</span>
            </div>
            <div class="flex items-center gap-2 px-3 py-1.5 bg-white/60 dark:bg-white/5 border border-white/60 dark:border-white/10 rounded-full transition-colors duration-500" title="Active Listeners">
              <svg class="w-3 h-3 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
              <span id="listeners-count" class="text-[10px] font-mono font-bold text-gray-700 dark:text-gray-300 mt-px">0</span>
            </div>
          </div>

          <!-- Album Art -->
          <div class="relative w-56 h-56 sm:w-64 sm:h-64 mb-8 rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.15)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.5)] group border border-white/60 dark:border-white/10 z-10 transition-shadow duration-500">
            <img id="cover-art" src="https://images.nismara.my.id/web/images/nismara_transport_heavy_load.webp" alt="Album Art" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 dark:from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <!-- Playlist Badge -->
            <div id="playlist-badge" class="absolute bottom-3 left-3 px-2 py-1 bg-white/80 dark:bg-black/50 backdrop-blur-md rounded border border-gray-200/50 dark:border-white/10 text-[9px] font-mono uppercase text-gray-800 dark:text-white/80 hidden transition-colors duration-500">
              Pop
            </div>
          </div>

          <!-- Track Info -->
          <div class="text-center w-full mb-10 z-10">
            <h1 id="track-title" class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white tracking-tight mb-2 truncate px-4 transition-colors duration-500">Memuat Data...</h1>
            <p id="track-artist" class="text-sm sm:text-base text-gray-600 dark:text-gray-400 font-light truncate px-4 transition-colors duration-500">Nismara Radio</p>
          </div>

          <!-- Audio Player & Controls -->
          <div class="w-full z-10">
            <!-- Hidden Audio Element -->
            <audio id="audio-player" preload="none" crossorigin="anonymous">
               <source src="https://radio.nismara.web.id:8443/listen/nismara_radio/radio.mp3" type="audio/mpeg" />
            </audio>
            
            <div class="flex flex-col items-center justify-center gap-8">
              <!-- Play/Pause Button -->
              <button id="play-btn" class="w-20 h-20 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 flex items-center justify-center transition-all duration-300 hover:scale-105 hover:shadow-[0_0_40px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_0_40px_rgba(255,255,255,0.3)] focus:outline-none focus:ring-4 focus:ring-gray-900/20 dark:focus:ring-white/20 group relative">
                <!-- Play Icon -->
                <svg id="icon-play" class="w-8 h-8 ml-1 transform group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <!-- Pause Icon (Hidden by default) -->
                <svg id="icon-pause" class="w-8 h-8 hidden transform group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </svg>
                
                <!-- Custom Loader (Hidden initially) -->
                <div id="audio-loader" class="hidden absolute inset-0 rounded-full bg-gray-900/90 dark:bg-white/90 flex items-center justify-center transition-colors duration-500">
                  <svg class="animate-spin text-white dark:text-gray-900 w-8 h-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </div>
              </button>

              <!-- Volume Control -->
              <div class="w-full max-w-[200px] flex items-center gap-4 opacity-40 hover:opacity-100 transition-opacity duration-300">
                <svg class="w-4 h-4 text-gray-700 dark:text-white shrink-0 transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5 10v4a2 2 0 002 2h2.586l3.707 3.707a.999.999 0 001.707-.707V4.707a.999.999 0 00-1.707-.707L9.586 7.707H7a2 2 0 00-2 2z"></path></svg>
                <input type="range" id="volume-slider" min="0" max="100" value="80" class="w-full h-1 bg-gray-300 dark:bg-white/20 rounded-lg appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-gray-400/50 dark:focus:ring-white/50 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:bg-gray-800 dark:[&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:hover:scale-125 [&::-webkit-slider-thumb]:transition-transform transition-colors duration-500">
              </div>
              
              <!-- Request Song Button -->
              <button id="open-request-modal-btn" class="mt-2 px-5 py-2 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 border border-gray-300 dark:border-white/20 rounded-full text-[10px] uppercase font-mono font-bold tracking-widest text-gray-800 dark:text-white transition-all duration-300 flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-white/30">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path></svg>
                Request Song
              </button>
            </div>
          </div>

          <!-- Up Next Section -->
          <div id="up-next-container" class="w-full border-t border-gray-200 dark:border-white/10 mt-8 pt-6 z-10 flex flex-col items-start hidden transition-colors duration-500">
            <span class="text-[9px] font-mono tracking-[0.2em] text-gray-500 uppercase mb-3 px-1">Up Next</span>
            <div class="flex items-center gap-3 w-full bg-white/60 dark:bg-white/5 hover:bg-white/80 dark:hover:bg-white/10 transition-colors p-2 rounded-xl border border-white/60 dark:border-white/5">
              <img id="next-art" src="" alt="Next Song Art" class="w-10 h-10 rounded-lg object-cover border border-gray-200 dark:border-white/10 shadow-sm dark:shadow-md" />
              <div class="flex flex-col flex-1 overflow-hidden">
                <span id="next-title" class="text-sm font-medium text-gray-900 dark:text-white/90 truncate transition-colors duration-500">Loading...</span>
                <span id="next-artist" class="text-xs text-gray-500 dark:text-gray-400 truncate transition-colors duration-500"></span>
              </div>
            </div>
          </div>
          
        </div>
      </div>

      <!-- Right Column: Info Panels -->
      <div class="lg:col-span-6 xl:col-span-7 flex flex-col gap-8">
        
        <!-- Schedule Section -->
        <div id="schedule-container" class="w-full bg-white/40 dark:bg-white/5 backdrop-blur-xl border border-white/60 dark:border-white/10 rounded-[2.5rem] p-6 sm:p-8 shadow-xl dark:shadow-2xl opacity-0 transition-all duration-1000">
          <h3 class="text-[11px] sm:text-xs font-mono tracking-[0.2em] text-primary-600 dark:text-primary-400 uppercase mb-6 flex items-center gap-3 px-2 transition-colors duration-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            Jadwal Siaran
          </h3>
          <div id="schedule-list" class="flex flex-col gap-3 max-h-[320px] overflow-y-auto pr-2 custom-scrollbar">
            <!-- Schedule items will be injected here -->
          </div>
        </div>

        <!-- History Section -->
        <div id="history-container" class="w-full bg-white/40 dark:bg-white/5 backdrop-blur-xl border border-white/60 dark:border-white/10 rounded-[2.5rem] p-6 sm:p-8 shadow-xl dark:shadow-2xl opacity-0 transition-all duration-1000">
          <h3 class="text-[11px] sm:text-xs font-mono tracking-[0.2em] text-gray-500 dark:text-gray-400 uppercase mb-6 flex items-center gap-3 px-2 transition-colors duration-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Baru Saja Diputar
          </h3>
          <div id="history-list" class="flex flex-col gap-3">
            <!-- History items will be injected here -->
          </div>
        </div>
      </div>
    </div>
  </div>
    <!-- Request Modal -->
    <div id="request-modal" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
      <div class="absolute inset-0 bg-gray-900/40 dark:bg-black/60 backdrop-blur-sm transition-colors duration-500" id="close-modal-overlay"></div>
      <div class="relative w-full max-w-lg bg-white/80 dark:bg-white/10 border border-white/60 dark:border-white/20 rounded-[2.5rem] p-6 sm:p-8 shadow-2xl backdrop-blur-2xl flex flex-col h-full max-h-[80vh] m-4 transform scale-95 transition-all duration-500" id="request-modal-content">
        
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white tracking-tight flex items-center gap-2 transition-colors duration-500">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path></svg>
            Request Song
          </h2>
          <button id="close-modal-btn" class="text-gray-500 dark:text-white/50 hover:text-gray-900 dark:hover:text-white transition-colors bg-black/5 dark:bg-white/5 p-2 rounded-full hover:bg-black/10 dark:hover:bg-white/10">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>

        <div class="relative mb-6 shrink-0">
          <input type="text" id="request-search" placeholder="Search by title or artist..." class="w-full bg-white/50 dark:bg-black/20 border border-gray-200 dark:border-white/10 rounded-xl px-4 py-3.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-white/40 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors duration-500">
          <svg class="w-5 h-5 text-gray-400 dark:text-white/40 absolute right-4 top-3.5 transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>

        <div id="request-loading" class="hidden flex-col items-center justify-center py-12 flex-1">
          <svg class="animate-spin text-gray-400 dark:text-white/20 w-10 h-10 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          <span class="text-xs text-gray-500 dark:text-white/50 font-mono transition-colors duration-500">Memuat daftar lagu...</span>
        </div>

        <div id="request-list-container" class="flex-1 overflow-y-auto custom-scrollbar pr-2 flex flex-col gap-2 min-h-0">
          <!-- Request items injected here -->
        </div>

      </div>
    </div>
  </section>

  <!-- ETS2 / ATS Integration Section -->
  <section class="pt-24 pb-40 lg:pb-56 bg-white dark:bg-gray-900 transition-colors duration-500 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gray-200 dark:via-gray-800 to-transparent"></div>
    
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-800 rounded-[2.5rem] p-8 md:p-12 lg:p-16 shadow-xl shadow-gray-200/50 dark:shadow-none relative overflow-hidden transition-colors duration-500">
        
        <!-- Abstract Shape Glow -->
        <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-primary-600/10 dark:bg-primary-500/10 blur-[100px] rounded-full pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-blue-500/10 dark:bg-blue-500/10 blur-[80px] rounded-full pointer-events-none"></div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 relative z-10 items-center">
          
          <!-- Text content -->
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-50 dark:bg-primary-900/30 border border-primary-100 dark:border-primary-800/50 mb-6">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
              </span>
              <span class="text-[10px] font-mono tracking-[0.2em] text-primary-600 dark:text-primary-400 uppercase font-bold">Game Integration</span>
            </div>
            
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6 leading-tight tracking-tight">Dengarkan Langsung di Dalam Kabin Truk Anda</h2>
            <p class="text-base text-gray-600 dark:text-gray-400 mb-10 leading-relaxed">
              Buat perjalanan mengemudi virtual Anda lebih imersif. Tambahkan stasiun Nismara Radio ke dalam *in-game radio* Euro Truck Simulator 2 atau American Truck Simulator dengan panduan mudah di bawah ini.
            </p>
            
            <div class="space-y-6 mb-10">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-white dark:bg-gray-800 shadow-sm border border-gray-100 dark:border-gray-700 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 font-bold font-mono text-sm">1</div>
                <div>
                  <h4 class="text-gray-900 dark:text-white font-semibold text-lg mb-1">Unduh File Konfigurasi</h4>
                  <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Klik tombol unduh di bawah ini untuk mendapatkan file <code class="bg-gray-100 dark:bg-gray-900 px-1.5 py-0.5 rounded text-primary-600 dark:text-primary-400 text-xs font-mono border border-gray-200 dark:border-gray-700">live_streams.sii</code> resmi dari kami.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-white dark:bg-gray-800 shadow-sm border border-gray-100 dark:border-gray-700 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 font-bold font-mono text-sm">2</div>
                <div>
                  <h4 class="text-gray-900 dark:text-white font-semibold text-lg mb-1">Pindahkan ke Direktori Game</h4>
                  <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Salin file tersebut ke folder Documents PC Anda: <br><code class="bg-gray-100 dark:bg-gray-900 px-1.5 py-0.5 rounded text-gray-700 dark:text-gray-300 text-[11px] font-mono border border-gray-200 dark:border-gray-700 mt-1 inline-block">Documents \ Euro Truck Simulator 2</code> <br> *(Timpa file jika sebelumnya sudah ada)*.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-white dark:bg-gray-800 shadow-sm border border-gray-100 dark:border-gray-700 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 font-bold font-mono text-sm">3</div>
                <div>
                  <h4 class="text-gray-900 dark:text-white font-semibold text-lg mb-1">Mainkan di Game</h4>
                  <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Buka ETS2/ATS, masuk ke kabin, tekan tombol <code class="bg-gray-100 dark:bg-gray-900 px-1.5 py-0.5 rounded text-primary-600 dark:text-primary-400 text-xs font-mono border border-gray-200 dark:border-gray-700">R</code> (Radio), lalu pilih Internet Radio dan cari <strong>Nismara Radio</strong>.</p>
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-4">
              <a href="https://link.nismara.web.id/streamfiles" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary-600 hover:bg-primary-500 text-white rounded-xl font-medium transition-all shadow-lg shadow-primary-600/20 hover:shadow-primary-600/40 hover:-translate-y-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Download live_streams.sii
              </a>
              <a href="https://link.nismara.web.id/discord" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700 rounded-xl font-medium transition-all hover:shadow-md">
                Butuh Bantuan?
              </a>
            </div>
          </div>
          
          <!-- Image Showcase -->
          <div class="relative group mt-8 lg:mt-0">
            <div class="absolute -inset-1 sm:-inset-4 bg-gradient-to-r from-primary-600 to-blue-500 rounded-3xl blur-2xl opacity-10 dark:opacity-20 group-hover:opacity-30 dark:group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
            <div class="relative rounded-[2rem] overflow-hidden border border-gray-200/50 dark:border-white/10 shadow-2xl bg-gray-900">
              <img src="https://images.nismara.my.id/web/images/nismara_transport_heavy_load.webp" alt="ETS2 Truck Dashboard" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000 opacity-90">
              
              <!-- Faux UI Overlay to make it look like a game radio -->
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-6 pt-20">
                <div class="flex items-center gap-4 bg-black/40 backdrop-blur-md border border-white/10 rounded-2xl p-4 transform translate-y-2 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-500">
                  <div class="w-12 h-12 bg-primary-600 rounded-xl flex items-center justify-center shadow-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path></svg>
                  </div>
                  <div>
                    <div class="text-white font-bold text-sm">Nismara Radio</div>
                    <div class="text-primary-400 text-xs font-mono">128 kbps • Live</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </section>

  <style>
    .music-note {
      position: absolute;
      bottom: -15%;
      user-select: none;
      animation: floatUp 15s infinite ease-in-out;
      font-family: Arial, sans-serif; /* For clean unicode note symbols */
      will-change: transform, opacity;
    }
    
    /* Left Side Notes */
    .note-l1 { left: 5%; animation-duration: 18s; animation-delay: 0s; font-size: 5rem; filter: blur(2px); }
    .note-l2 { left: 15%; animation-duration: 22s; animation-delay: 5s; font-size: 8rem; filter: blur(4px); opacity: 0.5; }
    .note-l3 { left: 8%; animation-duration: 16s; animation-delay: 2s; font-size: 4rem; filter: blur(1px); }
    .note-l4 { left: 22%; animation-duration: 20s; animation-delay: 7s; font-size: 7rem; filter: blur(3px); }
    .note-l5 { left: 2%; animation-duration: 25s; animation-delay: 12s; font-size: 10rem; filter: blur(6px); opacity: 0.3; }
    .note-l6 { left: 18%; animation-duration: 19s; animation-delay: 9s; font-size: 4.5rem; filter: blur(1px); }
    .note-l7 { left: 12%; animation-duration: 21s; animation-delay: 3s; font-size: 6rem; filter: blur(2px); }

    /* Right Side Notes */
    .note-r1 { left: 85%; animation-duration: 19s; animation-delay: 1s; font-size: 6rem; filter: blur(2px); }
    .note-r2 { left: 78%; animation-duration: 23s; animation-delay: 6s; font-size: 9rem; filter: blur(5px); opacity: 0.4; }
    .note-r3 { left: 92%; animation-duration: 17s; animation-delay: 3s; font-size: 4.5rem; filter: blur(1px); }
    .note-r4 { left: 82%; animation-duration: 21s; animation-delay: 8s; font-size: 7.5rem; filter: blur(3px); }
    .note-r5 { left: 96%; animation-duration: 26s; animation-delay: 13s; font-size: 11rem; filter: blur(7px); opacity: 0.25; }
    .note-r6 { left: 88%; animation-duration: 18s; animation-delay: 10s; font-size: 5rem; filter: blur(1.5px); }
    .note-r7 { left: 75%; animation-duration: 24s; animation-delay: 4s; font-size: 6.5rem; filter: blur(2.5px); opacity: 0.6; }

    /* Custom Scrollbar for sleek UI */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
      border-radius: 8px;
    }
    :global(.dark) .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.05);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.2);
      border-radius: 8px;
    }
    :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.2);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(0, 0, 0, 0.3);
    }
    :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) rotate(0deg) scale(0.8) translateX(0);
        opacity: 0;
      }
      15% {
        opacity: 0.8;
      }
      50% {
        transform: translateY(-60vh) rotate(45deg) scale(1) translateX(50px);
      }
      85% {
        opacity: 0.8;
      }
      100% {
        transform: translateY(-130vh) rotate(90deg) scale(0.8) translateX(-50px);
        opacity: 0;
      }
    }
  </style>

  <script>
    // In Astro, script tags are type="module" and run after the DOM is ready by default.
    const audioPlayer = document.getElementById('audio-player') as HTMLAudioElement;
    const playBtn = document.getElementById('play-btn');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');
    const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
    const audioLoader = document.getElementById('audio-loader');
    
    // Now Playing UI
    const titleEl = document.getElementById('track-title');
    const artistEl = document.getElementById('track-artist');
    const coverEl = document.getElementById('cover-art') as HTMLImageElement;
    const bgBlur = document.getElementById('bg-blur');
    const listenersEl = document.getElementById('listeners-count');
    const playlistBadge = document.getElementById('playlist-badge');
    
    // Up Next UI
    const upNextContainer = document.getElementById('up-next-container');
    const nextTitleEl = document.getElementById('next-title');
    const nextArtistEl = document.getElementById('next-artist');
    const nextArtEl = document.getElementById('next-art') as HTMLImageElement;

    // History UI
    const historyContainer = document.getElementById('history-container');
    const historyList = document.getElementById('history-list');

    let currentSongId = "";
    
    // --- Request Modal Logic ---
    const openRequestModalBtn = document.getElementById('open-request-modal-btn');
    const requestModal = document.getElementById('request-modal');
    const requestModalContent = document.getElementById('request-modal-content');
    const closeModalOverlay = document.getElementById('close-modal-overlay');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const requestSearch = document.getElementById('request-search') as HTMLInputElement;
    const requestListContainer = document.getElementById('request-list-container');
    const requestLoading = document.getElementById('request-loading');

    let requestableSongs: any[] = [];

    const toggleModal = (show: boolean) => {
      if (show) {
        requestModal?.classList.remove('opacity-0', 'pointer-events-none');
        requestModalContent?.classList.remove('scale-95');
        requestModalContent?.classList.add('scale-100');
        fetchRequests();
      } else {
        requestModal?.classList.add('opacity-0', 'pointer-events-none');
        requestModalContent?.classList.add('scale-95');
        requestModalContent?.classList.remove('scale-100');
      }
    };

    if (openRequestModalBtn) openRequestModalBtn.addEventListener('click', () => toggleModal(true));
    if (closeModalOverlay) closeModalOverlay.addEventListener('click', () => toggleModal(false));
    if (closeModalBtn) closeModalBtn.addEventListener('click', () => toggleModal(false));

    const fetchRequests = async () => {
      if (requestableSongs.length > 0) return; // Already fetched
      if (requestLoading) requestLoading.classList.remove('hidden');
      if (requestListContainer) requestListContainer.innerHTML = '';
      
      try {
        const res = await fetch('/api/requests');
        if (!res.ok) throw new Error('API error');
        const data = await res.json();
        requestableSongs = data;
        renderRequests(requestableSongs);
      } catch (e) {
        console.error(e);
        if (requestListContainer) requestListContainer.innerHTML = '<div class="text-center text-red-400 py-8 text-sm">Gagal memuat daftar request.</div>';
      } finally {
        if (requestLoading) requestLoading.classList.add('hidden');
      }
    };

    const renderRequests = (songs: any[]) => {
      if (!requestListContainer) return;
      if (songs.length === 0) {
        requestListContainer.innerHTML = '<div class="text-center text-white/50 py-8 text-sm">Lagu tidak ditemukan.</div>';
        return;
      }

      requestListContainer.innerHTML = songs.map(item => `
        <div class="flex items-center justify-between p-3 sm:p-4 bg-white/50 dark:bg-black/20 hover:bg-white/80 dark:hover:bg-black/40 border border-gray-200 dark:border-white/5 rounded-xl transition-colors group">
          <div class="flex flex-col flex-1 overflow-hidden pr-4">
            <span class="text-sm font-medium text-gray-900 dark:text-white truncate">${item.song.title}</span>
            <span class="text-xs text-gray-500 dark:text-gray-400 truncate">${item.song.artist}</span>
          </div>
          <button data-request-id="${item.request_id}" class="request-submit-btn shrink-0 px-4 py-2 bg-primary-600 hover:bg-primary-500 text-white text-[10px] uppercase font-bold tracking-wider rounded-lg transition-colors focus:ring-2 focus:ring-primary-500/50 outline-none flex items-center gap-2">
            <span>Request</span>
          </button>
        </div>
      `).join('');

      // Bind events to new buttons
      document.querySelectorAll('.request-submit-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const reqId = target.getAttribute('data-request-id');
          if (!reqId) return;

          // Loading state
          const originalText = target.innerHTML;
          target.innerHTML = '<svg class="animate-spin w-3 h-3 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
          target.disabled = true;
          
          try {
            const res = await fetch(`/api/request/${reqId}`, { method: 'POST' });
            const data = await res.json();
            
            if (res.ok) {
              target.innerHTML = 'Success ✓';
              target.classList.replace('bg-primary-600', 'bg-green-600');
              target.classList.replace('hover:bg-primary-500', 'hover:bg-green-600');
            } else {
              target.innerHTML = 'Gagal ✕';
              target.classList.replace('bg-primary-600', 'bg-red-600');
              target.classList.replace('hover:bg-primary-500', 'hover:bg-red-600');
              alert(data.message || 'Gagal mengirim request lagu.');
            }
          } catch (err) {
            target.innerHTML = 'Gagal ✕';
            target.classList.replace('bg-primary-600', 'bg-red-600');
            target.classList.replace('hover:bg-primary-500', 'hover:bg-red-600');
            alert('Terjadi kesalahan jaringan.');
          } finally {
            setTimeout(() => {
              target.innerHTML = originalText;
              target.disabled = false;
              target.classList.remove('bg-green-600', 'bg-red-600', 'hover:bg-green-600', 'hover:bg-red-600');
              target.classList.add('bg-primary-600', 'hover:bg-primary-500');
            }, 3000);
          }
        });
      });
    };

    if (requestSearch) {
      requestSearch.addEventListener('input', (e) => {
        const keyword = (e.target as HTMLInputElement).value.toLowerCase();
        const filtered = requestableSongs.filter(
          (item: any) =>
            item.song.title.toLowerCase().includes(keyword) ||
            item.song.artist.toLowerCase().includes(keyword),
        );
        renderRequests(filtered);
      });
    }

    // Setup Volume
    if (audioPlayer && volumeSlider) {
      audioPlayer.volume = parseInt(volumeSlider.value) / 100;
      volumeSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        audioPlayer.volume = parseInt(target.value) / 100;
      });
    }

    // Play/Pause Interactions
    if (playBtn && audioPlayer && iconPlay && iconPause) {
      playBtn.addEventListener('click', () => {
        if (audioPlayer.paused) {
          if (audioLoader) audioLoader.classList.remove('hidden');
          if (iconPlay) iconPlay.classList.add('opacity-0'); 
          
          audioPlayer.play().then(() => {
            if (audioLoader) audioLoader.classList.add('hidden');
            if (iconPlay) iconPlay.classList.add('hidden');
            if (iconPlay) iconPlay.classList.remove('opacity-0');
            if (iconPause) iconPause.classList.remove('hidden');
          }).catch(e => {
            console.error("Playback failed:", e);
            if (audioLoader) audioLoader.classList.add('hidden');
            if (iconPlay) iconPlay.classList.remove('opacity-0');
            if (iconPlay) iconPlay.classList.remove('hidden');
            alert("Gagal memutar radio. Pastikan ekstensi pemblokir iklan tidak menghalangi stream, atau coba sesaat lagi.");
          });
        } else {
          audioPlayer.pause();
        }
      });

      audioPlayer.addEventListener('play', () => {
        if (audioLoader) audioLoader.classList.add('hidden');
        if (iconPlay) iconPlay.classList.add('hidden');
        if (iconPause) iconPause.classList.remove('hidden');
        const floatingNotes = document.getElementById('floating-notes');
        if (floatingNotes) floatingNotes.classList.remove('opacity-0');
      });

      audioPlayer.addEventListener('pause', () => {
        if (iconPlay) iconPlay.classList.remove('hidden');
        if (iconPause) iconPause.classList.add('hidden');
        const floatingNotes = document.getElementById('floating-notes');
        if (floatingNotes) floatingNotes.classList.add('opacity-0');
      });

      audioPlayer.addEventListener('ended', () => {
        if (iconPlay) iconPlay.classList.remove('hidden');
        if (iconPause) iconPause.classList.add('hidden');
        const floatingNotes = document.getElementById('floating-notes');
        if (floatingNotes) floatingNotes.classList.add('opacity-0');
      });
      
      audioPlayer.addEventListener('waiting', () => {
        if (iconPlay) iconPlay.classList.add('opacity-0');
        if (iconPause) iconPause.classList.add('hidden');
        if (audioLoader) audioLoader.classList.remove('hidden');
      });

      audioPlayer.addEventListener('playing', () => {
        if (audioLoader) audioLoader.classList.add('hidden');
        if (iconPlay) iconPlay.classList.remove('opacity-0');
        if (iconPlay) iconPlay.classList.add('hidden');
        if (iconPause) iconPause.classList.remove('hidden');
        const floatingNotes = document.getElementById('floating-notes');
        if (floatingNotes) floatingNotes.classList.remove('opacity-0');
      });
    }

    const formatTimeAgo = (timestamp: number) => {
      const seconds = Math.floor(Date.now() / 1000) - timestamp;
      if (seconds < 60) return `${seconds}s ago`;
      const minutes = Math.floor(seconds / 60);
      if (minutes < 60) return `${minutes}m ago`;
      return `${Math.floor(minutes / 60)}h ago`;
    };

    const formatScheduleTime = (startStr: string, endStr: string) => {
      const d1 = new Date(startStr);
      const d2 = new Date(endStr);
      const t1 = d1.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
      const t2 = d2.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
      return `${t1} - ${t2}`;
    };

    // Client-Side Polling for AzuraCast Schedule Data
    const updateSchedule = async () => {
      try {
        const scheduleContainer = document.getElementById('schedule-container');
        const scheduleList = document.getElementById('schedule-list');
        
        const res = await fetch('/api/schedule');
        if (!res.ok) throw new Error('API schedule response error');
        const data = await res.json();
        
        if (Array.isArray(data) && data.length > 0 && scheduleList && scheduleContainer) {
          scheduleList.innerHTML = data.map((item: any) => `
            <div class="flex items-center gap-4 p-4 bg-white/60 dark:bg-white/5 hover:bg-white/80 dark:hover:bg-white/10 transition-colors rounded-xl border ${item.is_now ? 'border-primary-500/50 shadow-[0_0_15px_rgba(var(--color-primary-600),0.3)]' : 'border-gray-200 dark:border-white/5'} backdrop-blur-sm">
              <div class="flex flex-col items-center justify-center shrink-0 w-16 text-center border-r border-gray-200 dark:border-white/10 pr-4">
                <span class="text-xs font-mono font-bold ${item.is_now ? 'text-primary-600 dark:text-primary-400' : 'text-gray-700 dark:text-gray-300'}">${formatScheduleTime(item.start, item.end).split(' - ')[0]}</span>
                <span class="text-[10px] text-gray-500 font-mono">${formatScheduleTime(item.start, item.end).split(' - ')[1]}</span>
              </div>
              <div class="flex flex-col flex-1 overflow-hidden">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium ${item.is_now ? 'text-gray-900 dark:text-white' : 'text-gray-800 dark:text-white/80'} truncate">${item.name}</span>
                  ${item.is_now ? '<span class="text-[8px] font-mono tracking-widest bg-primary-600 text-white px-1.5 py-0.5 rounded-sm uppercase">Now</span>' : ''}
                </div>
                <span class="text-xs text-gray-500 dark:text-gray-400 truncate">${item.type === 'playlist' ? 'Playlist' : 'Live Show'}</span>
              </div>
            </div>
          `).join('');
          
          scheduleContainer.classList.remove('opacity-0');
        }
      } catch (error) {
        console.error("Failed to fetch schedule data:", error);
      }
    };

    // Client-Side Polling for AzuraCast Now Playing Data
    const updateNowPlaying = async () => {
      try {
        const res = await fetch('/api/radio');
        if (!res.ok) throw new Error('API response error');
        const data = await res.json();

        // 1. Update Listeners
        if (listenersEl && data.listeners) {
          listenersEl.innerText = data.listeners.current || 0;
        }

        // 2. Update Now Playing
        if (data.now_playing && data.now_playing.song) {
          const song = data.now_playing.song;
          
          if (currentSongId !== song.id) {
            currentSongId = song.id;
            
            if (titleEl) {
              titleEl.style.opacity = '0';
              setTimeout(() => {
                titleEl.innerText = song.title || 'Siaran Langsung';
                titleEl.style.opacity = '1';
              }, 300);
            }
            
            if (artistEl) {
              artistEl.style.opacity = '0';
              setTimeout(() => {
                artistEl.innerText = song.artist || 'Nismara Radio';
                artistEl.style.opacity = '1';
              }, 300);
            }
            
            if (song.art) {
              if (coverEl) coverEl.src = song.art;
              if (bgBlur) bgBlur.style.backgroundImage = `url('${song.art}')`;
            }

            if (playlistBadge) {
              if (data.now_playing.playlist) {
                playlistBadge.innerText = data.now_playing.playlist;
                playlistBadge.classList.remove('hidden');
              } else {
                playlistBadge.classList.add('hidden');
              }
            }
          }
        }

        // 3. Update "Playing Next"
        if (data.playing_next && data.playing_next.song && upNextContainer) {
          const nextSong = data.playing_next.song;
          if (nextTitleEl) nextTitleEl.innerText = nextSong.title || 'Unknown';
          if (nextArtistEl) nextArtistEl.innerText = nextSong.artist || 'Unknown';
          if (nextArtEl) nextArtEl.src = nextSong.art || '';
          upNextContainer.classList.remove('hidden');
        } else if (upNextContainer) {
          upNextContainer.classList.add('hidden');
        }

        // 4. Update "History"
        if (data.song_history && data.song_history.length > 0 && historyList && historyContainer) {
          // Keep only the last 4 songs
          const recentHistory = data.song_history.slice(0, 4);
          
          historyList.innerHTML = recentHistory.map((item: any) => `
            <div class="flex items-center gap-3 p-3 bg-white/60 dark:bg-white/5 hover:bg-white/80 dark:hover:bg-white/10 transition-colors rounded-xl border border-gray-200 dark:border-white/5 backdrop-blur-sm">
              <img src="${item.song.art}" alt="Art" class="w-12 h-12 rounded-lg object-cover shadow-sm" />
              <div class="flex flex-col flex-1 overflow-hidden">
                <span class="text-sm font-medium text-gray-900 dark:text-white/90 truncate">${item.song.title}</span>
                <span class="text-xs text-gray-500 dark:text-gray-400 truncate">${item.song.artist}</span>
              </div>
              <span class="text-[10px] text-gray-500 font-mono hidden sm:block">${formatTimeAgo(item.played_at)}</span>
            </div>
          `).join('');
          
          historyContainer.classList.remove('opacity-0');
        }

      } catch (error) {
        console.error("Failed to fetch radio data:", error);
      }
    };

    // Initial Fetch immediately on page load
    updateNowPlaying();
    updateSchedule();

    // Poll every 10 seconds (10000ms) for Now Playing
    setInterval(updateNowPlaying, 10000);
    // Poll every 1 minute (60000ms) for Schedule
    setInterval(updateSchedule, 60000);
  </script>
</Layout>
