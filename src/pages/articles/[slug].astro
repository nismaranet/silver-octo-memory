---
import { getArticle, urlFor, ARTICLES_QUERY } from '../../utils/sanity';
import { sanityClient } from 'sanity:client';
import Layout from '../../layouts/Layout.astro';
import { PortableText } from 'astro-portabletext';
import PortableTextImage from '../../components/PortableTextImage.astro';

export async function getStaticPaths() {
  const articles = await sanityClient.fetch(ARTICLES_QUERY);
  return articles.map((article: any) => ({
    params: { slug: article.slug.current },
  }));
}

const { slug } = Astro.params;
const article = await getArticle(slug);

if (!article) {
  return Astro.redirect('/404');
}

const mainImageUrl = article.mainImage ? urlFor(article.mainImage).width(1200).height(630).url() : undefined;
const customOgImageUrl = article.ogImage ? urlFor(article.ogImage).width(1200).height(630).url() : undefined;
const finalOgImage = customOgImageUrl || mainImageUrl;

// Generate an excerpt from the PortableText body
const generatedExcerpt = article.body?.find((b: any) => b._type === 'block' && b.children && b.children.length > 0)
  ?.children.map((c: any) => c.text).join('').substring(0, 160) + '...' 
  || `Read ${article.title} on Nismara Group Publications.`;

const finalDescription = article.seoDescription || generatedExcerpt;
const finalTitle = article.seoTitle ? `${article.seoTitle} | Nismara Group` : `${article.title} | Nismara Group`;
const authorName = article.author?.name || "Nismara Group";
---

<Layout 
  title={finalTitle}
  description={finalDescription}
  image={finalOgImage}
  type="article"
  author={authorName}
>
<main class="bg-white dark:bg-[#050505] transition-colors min-h-screen pb-32">
  <!-- Top Padding for Navbar -->
  <div class="h-32 md:h-40"></div>
  
  <div class="max-w-3xl mx-auto px-6">
    <a href="/articles" class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors mb-12 inline-flex items-center gap-2 text-sm font-mono uppercase tracking-widest">&larr; Back to Publications</a>
    
    <article class="prose lg:prose-xl prose-gray dark:prose-invert max-w-none">
      
      <div class="not-prose mb-6">
        {article.categories && article.categories.length > 0 && (
          <span class="inline-block px-3 py-1 bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400 text-[10px] font-bold uppercase tracking-widest rounded-full">
            {article.categories[0].title}
          </span>
        )}
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-gray-900 dark:text-white tracking-tight mb-8 not-prose leading-[1.1]">{article.title}</h1>
      
      <div class="flex flex-wrap items-center justify-between gap-4 mb-12 not-prose border-y border-black/5 dark:border-white/5 py-6">
        <div class="flex items-center gap-4">
          {article.author?.image && (
            <img 
              src={urlFor(article.author.image).width(48).height(48).url()} 
              alt={article.author.name}
              class="w-12 h-12 rounded-full border border-gray-200 dark:border-gray-800 object-cover"
            />
          )}
          <div class="flex flex-col">
            {article.author?.name && (
              <span class="text-gray-900 dark:text-white font-medium text-sm">{article.author.name}</span>
            )}
            {article.publishedAt && (
              <time class="text-xs text-gray-500 dark:text-gray-400 font-mono tracking-widest uppercase mt-1">
                {new Date(article.publishedAt).toLocaleDateString('en-CA').replace(/-/g, '.')}
              </time>
            )}
          </div>
        </div>

        <!-- Share Button -->
        <button id="share-btn" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:hover:bg-white/10 text-gray-700 dark:text-gray-300 rounded-full transition-colors text-xs font-mono uppercase tracking-widest">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
          <span>Share</span>
        </button>
      </div>

      {article.mainImage && (
        <div class="not-prose mb-16">
          <img 
            src={urlFor(article.mainImage).width(1200).height(600).url()} 
            alt={article.title}
            class="w-full rounded-2xl shadow-xl aspect-video object-cover"
          />
        </div>
      )}

      <div class="font-light leading-relaxed">
        <PortableText 
          value={article.body} 
          components={{
            type: {
              image: PortableTextImage,
            }
          }}
        />
      </div>
    </article>
  </div>
</main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const shareBtn = document.getElementById('share-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const shareData = {
          title: document.title,
          text: 'Check out this article from Nismara Group',
          url: window.location.href
        };
        
        try {
          if (navigator.share) {
            await navigator.share(shareData);
          } else {
            await navigator.clipboard.writeText(window.location.href);
            const originalContent = shareBtn.innerHTML;
            shareBtn.innerHTML = '<span class="text-green-600 dark:text-green-400">Copied!</span>';
            setTimeout(() => shareBtn.innerHTML = originalContent, 2000);
          }
        } catch (err) {
          console.error('Error sharing:', err);
        }
      });
    }
  });
</script>
